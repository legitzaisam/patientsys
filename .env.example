# Copy to .env and fill in from the Supabase dashboard (Project Settings > API).
# The VITE_ copies are the same values; they are bundled into the client, so
# only the publishable (anon) key belongs there - never the service role key.

SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses row-level security, so it must never be committed or
# exposed to the browser. Required by src/integrations/supabase/client.server.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres access, used only by scripts/ (migrations, snapshots). Copy the
# pooler string from Project Settings > Database; db.<ref>.supabase.co only
# resolves on projects with the IPv4 add-on.
DATABASE_URL=
DATABASE_PASSWORD=

# Phase 8 — outbox adapters. Leave unset (or COMMS_SANDBOX=1) so drain logs
# instead of calling Resend/Twilio. Never commit live keys.
COMMS_SANDBOX=1
COMMS_DRAIN_SECRET=
COMMS_FROM_EMAIL=
COMMS_FROM_NAME=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
APP_ORIGIN=

# Owner/manager sign-in codes. RESEND_API_KEY above doubles as the delivery
# route for email MFA: with it set, owners and managers must confirm each
# sign-in with a 6-digit code. With neither variable set the gate stands down
# rather than locking them out, so MFA is NOT active until Resend is configured.
#
# AUTH_DEV_SHOW_OTP=1 returns the code to the browser and renders it on the
# gate instead of emailing it. Local development only — it makes MFA a
# formality, so never set it anywhere real.
AUTH_DEV_SHOW_OTP=

# Signs one-click unsubscribe links in marketing/reminder email footers
# (rotating it invalidates every link already sent). Demo uses a fixed key.
COMMS_UNSUBSCRIBE_SECRET=

# Browser voice calls (demo) - see docs/voice-call-setup.md for the one-time
# Twilio console walkthrough. Calls dial one of TWILIO_DEMO_NUMBERS (comma-
# separated E.164 numbers you have verified on the trial account); each patient
# hashes to the same number every time. Leave unset to show the call button
# in its disabled state. TWILIO_ACCOUNT_SID is shared with the SMS adapter above.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_DEMO_NUMBERS=

# Demo-mode AI patient replies in the staff chat. Free trial key from
# https://dashboard.cohere.com/api-keys (1,000 calls/month, 20 chat req/min).
# Without a key the demo falls back to canned replies, so nothing breaks.
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026
