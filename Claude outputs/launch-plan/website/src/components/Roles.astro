---
// "Everyone in the room": what each role gets. Written in product voice, not
// as attributed quotes, until real permissioned testimonials exist.
import { links } from "../lib/links";
const roles = [
  {
    who: "Clinic owner",
    line: "See the whole clinic at a glance: revenue, retention, who needs attention today, and who is drifting away.",
    href: links.clinic,
    c: "var(--butter)",
  },
  {
    who: "Practitioner",
    line: "Your day, your patients, your notes and your earnings. Consent is checked before you start, every time.",
    href: links.practitioner,
    c: "var(--mint)",
  },
  {
    who: "Front desk",
    line: "Arrivals, deposits, forms and reminders in one queue, so the day runs on time.",
    href: links.frontDesk,
    c: "var(--arrived)",
  },
  {
    who: "Patient",
    line: "A plan you can follow, aftercare that checks in, and a clinic that remembers you between visits.",
    href: links.patient,
    c: "var(--aftercare)",
  },
];
const phrases = ["Consent before care", "Named practitioner on every record", "Aftercare that checks in", "Retention that runs itself", "Role-shaped dashboards", "Audit trail of every action", "A plan patients can see"];
---

<section class="roles section" aria-labelledby="roles-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Everyone in the room</p>
      <h2 id="roles-title" class="display" data-lines>
        <span class="line-mask"><span>One system, shaped</span></span>
        <span class="line-mask"><span>to <em>each role.</em></span></span>
      </h2>
    </div>
    <div class="roles__grid">
      {roles.map((r, i) => (
        <a class="role glass" href={r.href} data-light data-reveal data-astro-reload style={`--d:${i * 70}ms; --c:${r.c}`}>
          <span class="role__dot" />
          <h3>{r.who}</h3>
          <p>{r.line}</p>
          <span class="role__go">Try this view →</span>
        </a>
      ))}
    </div>
  </div>
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[...phrases, ...phrases].map((p) => <span>{p}<i>✦</i></span>)}
    </div>
  </div>
</section>

<style>
  .roles__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .role {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    text-decoration: none;
    min-height: 16rem;
    transition:
      transform var(--t-ui) var(--ease-dew),
      box-shadow var(--t-ui) var(--ease-dew);
  }
  .role:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }
  .role__dot {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, var(--c) 60%);
    box-shadow: 0 6px 16px -6px var(--c);
    margin-bottom: 0.6rem;
  }
  .role h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.7rem;
  }
  .role p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .role__go {
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--butter-ink);
  }
  .marquee {
    margin-top: clamp(3rem, 7vw, 6rem);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 60s linear infinite;
  }
  .marquee span {
    display: inline-flex;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    color: var(--ink-2);
    white-space: nowrap;
  }
  .marquee i {
    font-style: normal;
    font-size: 0.6em;
    color: var(--butter-deep);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (max-width: 1000px) {
    .roles__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .roles__grid {
      grid-template-columns: 1fr;
    }
    .role {
      min-height: 0;
    }
  }
</style>
