---
import { links } from "../lib/links";
import Mark from "./Mark.astro";
---

<header class="topbar" data-topbar>
  <div class="topbar__inner wrap">
    <a class="brand" href="/" aria-label="Aetheria home">
      <Mark size={30} />
      <span class="brand__word">Aetheria</span>
    </a>

    <nav class="nav" aria-label="Main">
      <a href="/#journey">How it works</a>
      <a href="/#patients">For patients</a>
      <a href="/#clinics">For clinics</a>
      <a href="/#safety">Safety</a>
    </nav>

    <div class="actions">
      <div class="signin" data-signin>
        <button class="signin__btn" aria-expanded="false" aria-controls="signin-panel" data-signin-btn>
          Sign in
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <div class="signin__panel glass" id="signin-panel" hidden data-signin-panel>
          <a class="signin__row" href={links.clinic} data-astro-reload>
            <span class="signin__dot" style="--c: var(--arrived)"></span>
            <span>
              <strong>Clinic team</strong>
              <small>Diary, records, consent and retention</small>
            </span>
          </a>
          <a class="signin__row" href={links.patient} data-astro-reload>
            <span class="signin__dot" style="--c: var(--aftercare)"></span>
            <span>
              <strong>Patients</strong>
              <small>Your plan, aftercare and progress</small>
            </span>
          </a>
          <a class="signin__all" href="/login">All sign-in options →</a>
        </div>
      </div>
      <a class="btn btn--butter topbar__cta" href={links.clinic} data-astro-reload data-magnetic>Explore the demo</a>
      <button class="menu-btn" aria-expanded="false" aria-controls="mobile-nav" data-menu-btn>
        <span class="sr-only">Menu</span>
        <span class="menu-btn__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <nav class="mobile-nav glass" id="mobile-nav" hidden aria-label="Mobile" data-mobile-nav>
    <a href="/#journey">How it works</a>
    <a href="/#patients">For patients</a>
    <a href="/#clinics">For clinics</a>
    <a href="/#safety">Safety</a>
    <a href="/login">Sign in</a>
  </nav>
</header>

<style>
  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding-top: calc(0.9rem + env(safe-area-inset-top, 0px));
    transition: transform var(--t-section) var(--ease-dew);
  }
  .topbar.is-hidden {
    transform: translateY(-120%);
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.5rem 0.55rem 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid transparent;
    transition:
      background var(--t-ui) var(--ease-dew),
      border-color var(--t-ui) var(--ease-dew),
      box-shadow var(--t-ui) var(--ease-dew);
  }
  .topbar.is-scrolled .topbar__inner {
    background: var(--glass);
    border-color: var(--edge);
    box-shadow: var(--shadow-glass);
    backdrop-filter: blur(var(--blur-glass)) saturate(1.3);
    -webkit-backdrop-filter: blur(var(--blur-glass)) saturate(1.3);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .brand__word {
    font-family: var(--font-display);
    font-size: 1.55rem;
    letter-spacing: -0.01em;
  }
  .nav {
    display: flex;
    gap: 0.25rem;
    margin-inline: auto;
  }
  .nav a {
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.95rem;
    color: var(--ink-2);
    transition:
      background var(--t-micro),
      color var(--t-micro);
  }
  .nav a:hover {
    background: var(--butter-wash);
    color: var(--ink);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }
  .topbar__cta {
    min-height: 2.6rem;
    padding: 0.55rem 1.1rem;
  }
  .signin {
    position: relative;
  }
  .signin__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.6rem;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--edge);
    background: var(--glass-2);
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .signin__btn svg {
    width: 14px;
    height: 14px;
    transition: transform var(--t-ui) var(--ease-dew);
  }
  .signin__btn[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  .signin__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    width: 19rem;
    padding: 0.5rem;
    background: var(--glass);
    display: grid;
    gap: 0.2rem;
    transform-origin: top right;
    animation: pop var(--t-ui) var(--ease-dew);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.97);
    }
  }
  .signin__row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.75rem;
    border-radius: 12px;
    text-decoration: none;
    transition: background var(--t-micro);
  }
  .signin__row:hover,
  .signin__row:focus-visible {
    background: var(--butter-wash);
  }
  .signin__row strong {
    display: block;
    font-size: 0.98rem;
  }
  .signin__row small {
    color: var(--ink-3);
    font-size: 0.84rem;
  }
  .signin__dot {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    margin-top: 0.4rem;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 30%, transparent);
  }
  .signin__all {
    padding: 0.55rem 0.75rem;
    font-size: 0.85rem;
    color: var(--ink-3);
    text-decoration: none;
    border-top: 1px solid var(--edge-2);
    margin-top: 0.2rem;
  }
  .menu-btn {
    display: none;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid var(--edge);
    background: var(--glass-2);
    cursor: pointer;
  }
  .menu-btn__bars,
  .menu-btn__bars::before {
    display: block;
    width: 16px;
    height: 1.5px;
    margin: auto;
    background: var(--ink);
    position: relative;
    transition: transform var(--t-ui) var(--ease-dew);
  }
  .menu-btn__bars::before {
    content: "";
    position: absolute;
    top: 5px;
  }
  .menu-btn__bars {
    top: -2.5px;
  }
  .menu-btn[aria-expanded="true"] .menu-btn__bars {
    transform: translateY(2.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded="true"] .menu-btn__bars::before {
    transform: translateY(-5px) rotate(-90deg);
  }
  .mobile-nav {
    margin: 0.6rem var(--gutter) 0;
    padding: 0.5rem;
    background: var(--glass);
    display: grid;
  }
  .mobile-nav a {
    padding: 0.85rem 1rem;
    text-decoration: none;
    border-radius: 12px;
    font-size: 1.05rem;
  }
  .mobile-nav a:hover {
    background: var(--butter-wash);
  }
  @media (max-width: 960px) {
    .nav {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .signin,
    .topbar__cta {
      display: none;
    }
    .menu-btn {
      display: block;
    }
    .topbar__inner {
      gap: 0.75rem;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>("[data-topbar]")!;
  const btn = bar.querySelector<HTMLButtonElement>("[data-signin-btn]")!;
  const panel = bar.querySelector<HTMLElement>("[data-signin-panel]")!;
  const menuBtn = bar.querySelector<HTMLButtonElement>("[data-menu-btn]")!;
  const mobile = bar.querySelector<HTMLElement>("[data-mobile-nav]")!;

  function toggle(button: HTMLButtonElement, el: HTMLElement, open?: boolean) {
    const next = open ?? button.getAttribute("aria-expanded") !== "true";
    button.setAttribute("aria-expanded", String(next));
    el.hidden = !next;
  }
  btn.addEventListener("click", (e) => {
    e.stopPropagation();
    toggle(btn, panel);
  });
  menuBtn.addEventListener("click", () => toggle(menuBtn, mobile));
  mobile.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) toggle(menuBtn, mobile, false);
  });
  document.addEventListener("click", (e) => {
    if (!panel.hidden && !panel.contains(e.target as Node)) toggle(btn, panel, false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !panel.hidden) {
      toggle(btn, panel, false);
      btn.focus();
    }
  });

  // Glass on scroll; hide while scrolling down, show when scrolling up.
  let last = 0;
  addEventListener(
    "scroll",
    () => {
      const y = scrollY;
      bar.classList.toggle("is-scrolled", y > 24);
      const menuOpen = !panel.hidden || !mobile.hidden;
      bar.classList.toggle("is-hidden", !menuOpen && y > 480 && y > last + 4);
      if (y < last - 4) bar.classList.remove("is-hidden");
      last = y;
    },
    { passive: true },
  );
</script>
