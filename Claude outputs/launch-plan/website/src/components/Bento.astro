---
// Clinic OS bento: small live UIs built in code, not video.
const stages = ["Booked", "Arrived", "Consent signed", "Waiting", "In treatment", "Complete"];
---

<section class="bento section" id="clinics" aria-labelledby="bento-title">
  <div class="wrap">
    <div class="bento__head">
      <div class="section-head">
        <p class="eyebrow">Clinic OS</p>
        <h2 id="bento-title" class="display" data-lines>
          <span class="line-mask"><span>Everything the clinic runs on,</span></span>
          <span class="line-mask"><span><em>moving together.</em></span></span>
        </h2>
      </div>
      <button class="bento__pause" type="button" data-motion-toggle aria-pressed="false">Pause motion</button>
    </div>

    <div class="grid">
      <article class="tile tile--diary glass" data-light data-reveal>
        <h3>Diary</h3>
        <p>Day, week and month views across practitioners. Drag to rebook; the patient hears about it.</p>
        <div class="mini-diary" aria-hidden="true">
          {["Dr Osei", "Dr Rahman", "Dr Whitfield"].map((p) => (
            <div class="mini-diary__col"><span>{p}</span><i /><i /><i /></div>
          ))}
          <div class="mini-diary__card"><b>11:15</b> Skin peel</div>
        </div>
      </article>

      <article class="tile tile--stage glass" data-light data-reveal style="--d: 80ms">
        <h3>Consent-gated visits</h3>
        <p>A visit can't reach waiting until consent is signed and witnessed.</p>
        <div class="stages" aria-hidden="true">
          {stages.map((s, i) => <span class="stage" style={`--i:${i}`}>{s}</span>)}
        </div>
      </article>

      <article class="tile tile--retention glass" data-light data-reveal data-inview style="--d: 160ms">
        <h3>Retention</h3>
        <p>At-risk scoring finds who is overdue, lapsing or lost, and turns them into recall tasks.</p>
        <svg class="curve" viewBox="0 0 300 120" aria-hidden="true">
          <path d="M0 100 C 40 90, 60 60, 100 64 S 160 40, 200 36 S 260 20, 300 14" pathLength="1" class="curve__line" />
          <path d="M0 100 C 40 90, 60 60, 100 64 S 160 40, 200 36 S 260 20, 300 14 V120 H0Z" class="curve__area" />
        </svg>
        <div class="kpi"><b>72%</b> retention on demo data</div>
      </article>

      <article class="tile tile--offer glass" data-light data-reveal data-inview style="--d: 80ms">
        <h3>Offers that send themselves</h3>
        <p>Stage-based offers on email, SMS and the portal. Consent rules are enforced in code, with one-click unsubscribe.</p>
        <div class="email" aria-hidden="true">
          <div class="email__to">To: patients due a review · opted in</div>
          <i style="--w: 80%; --i: 0"></i><i style="--w: 92%; --i: 1"></i><i style="--w: 64%; --i: 2"></i>
          <span class="email__btn">Book your review</span>
        </div>
      </article>

      <article class="tile tile--earn glass" data-light data-reveal data-inview style="--d: 160ms">
        <h3>Practitioner earnings</h3>
        <p>Commission captured per treatment: earned, collected and owed.</p>
        <div class="bars" aria-hidden="true">
          <span style="--h: 88%"><em>Earned</em></span>
          <span style="--h: 70%"><em>Collected</em></span>
          <span style="--h: 26%"><em>Owed</em></span>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .bento__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }
  .bento__pause {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid var(--edge-2);
    background: var(--glass-2);
    border-radius: 999px;
    padding: 0.45rem 0.95rem;
    cursor: pointer;
    font-size: 0.85rem;
    flex: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(15rem, auto);
    gap: 1.1rem;
  }
  .tile {
    padding: 1.5rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .tile h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.7rem;
    line-height: 1.05;
  }
  .tile p {
    margin: 0 0 0.8rem;
    color: var(--ink-2);
    font-size: 0.95rem;
    max-width: 28rem;
  }
  .tile--diary {
    grid-column: span 4;
    grid-row: span 2;
  }
  .tile--stage {
    grid-column: span 2;
    grid-row: span 2;
  }
  .tile--retention,
  .tile--offer,
  .tile--earn {
    grid-column: span 2;
  }

  /* Diary */
  .mini-diary {
    position: relative;
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
    min-height: 16rem;
    margin-top: 0.5rem;
  }
  .mini-diary__col {
    display: grid;
    grid-template-rows: auto repeat(3, 1fr);
    gap: 0.5rem;
    padding: 0.6rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--edge);
  }
  .mini-diary__col span {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-3);
  }
  .mini-diary__col i {
    border-radius: 10px;
    background: repeating-linear-gradient(0deg, rgba(47, 63, 102, 0.05) 0 1px, transparent 1px 14px);
  }
  .mini-diary__col:nth-child(1) i:nth-of-type(1),
  .mini-diary__col:nth-child(3) i:nth-of-type(3) {
    background: color-mix(in srgb, var(--mint) 50%, white);
    border-left: 3px solid var(--mint);
  }
  .mini-diary__col:nth-child(2) i:nth-of-type(3) {
    background: color-mix(in srgb, var(--aftercare) 35%, white);
    border-left: 3px solid var(--aftercare);
  }
  .mini-diary__card {
    position: absolute;
    left: 0.6rem;
    top: 46%;
    width: calc(33.33% - 1.7rem);
    padding: 0.7rem 0.8rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--butter) 55%, white);
    border-left: 3px solid var(--butter-deep);
    box-shadow: var(--shadow-lift);
    font-size: 0.85rem;
    animation: rebook 9s var(--ease-dew) infinite;
  }
  .mini-diary__card b {
    display: block;
    font-size: 0.72rem;
    color: var(--ink-3);
  }
  @keyframes rebook {
    0%,
    22% {
      transform: translateX(0) rotate(0);
    }
    30% {
      transform: translateX(35%) translateY(-6px) rotate(2deg);
    }
    40%,
    62% {
      transform: translateX(calc(100% + 1.95rem)) rotate(0);
    }
    70% {
      transform: translateX(calc(150% + 2rem)) translateY(-6px) rotate(-2deg);
    }
    80%,
    100% {
      transform: translateX(calc(200% + 3.9rem)) rotate(0);
    }
  }

  /* Stages */
  .stages {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.4rem;
  }
  .stage {
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--edge);
    background: rgba(255, 255, 255, 0.5);
    font-size: 0.88rem;
    color: var(--ink-3);
    animation: stage 12s var(--ease-dew) infinite;
    animation-delay: calc(var(--i) * 1.6s);
  }
  .stage:nth-child(3) {
    animation-name: stage-consent;
  }
  @keyframes stage {
    0%,
    3% {
      background: rgba(255, 255, 255, 0.5);
      color: var(--ink-3);
    }
    6%,
    13% {
      background: var(--butter);
      color: var(--ink);
      transform: translateX(6px);
    }
    18%,
    100% {
      background: rgba(143, 199, 234, 0.25);
      color: var(--ink);
    }
  }
  @keyframes stage-consent {
    0%,
    3% {
      background: rgba(255, 255, 255, 0.5);
      color: var(--ink-3);
    }
    6%,
    13% {
      background: var(--consent);
      color: #fff;
      transform: translateX(6px);
    }
    18%,
    100% {
      background: rgba(185, 166, 232, 0.3);
      color: var(--consent-ink);
    }
  }

  /* Retention curve */
  .curve {
    width: 100%;
    height: auto;
    margin-top: auto;
  }
  .curve__line {
    fill: none;
    stroke: var(--success);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .curve__area {
    fill: rgba(74, 157, 117, 0.12);
    opacity: 0;
  }
  .tile--retention.is-in .curve__line {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 2s var(--ease-dew) 0.3s;
  }
  .tile--retention.is-in .curve__area {
    opacity: 1;
    transition: opacity 1s ease 1.6s;
  }
  .kpi {
    font-size: 0.85rem;
    color: var(--ink-3);
  }
  .kpi b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.8rem;
    color: var(--success-ink);
    margin-right: 0.3rem;
  }

  /* Offer email */
  .email {
    margin-top: auto;
    padding: 0.9rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--edge);
    display: grid;
    gap: 0.45rem;
  }
  .email__to {
    font-size: 0.72rem;
    color: var(--ink-3);
    margin-bottom: 0.2rem;
  }
  .email i {
    height: 7px;
    border-radius: 4px;
    background: rgba(47, 63, 102, 0.12);
    width: 0;
  }
  .tile--offer.is-in .email i {
    width: var(--w);
    transition: width 900ms var(--ease-dew) calc(300ms + var(--i) * 250ms);
  }
  .email__btn {
    justify-self: start;
    margin-top: 0.3rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--butter);
    font-size: 0.78rem;
    font-weight: 600;
    opacity: 0;
    transform: scale(0.9);
  }
  .tile--offer.is-in .email__btn {
    opacity: 1;
    transform: none;
    transition: all 600ms var(--ease-dew) 1.3s;
  }

  /* Earnings bars */
  .bars {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    gap: 0.8rem;
    height: 6.5rem;
  }
  .bars span {
    position: relative;
    flex: 1;
    height: 0;
    border-radius: 10px 10px 4px 4px;
    background: linear-gradient(180deg, var(--butter), var(--butter-deep));
  }
  .bars span:nth-child(3) {
    background: linear-gradient(180deg, var(--aftercare), #d97faa);
  }
  .tile--earn.is-in .bars span {
    height: var(--h);
    transition: height 1.1s var(--ease-dew);
  }
  .tile--earn.is-in .bars span:nth-child(2) {
    transition-delay: 150ms;
  }
  .tile--earn.is-in .bars span:nth-child(3) {
    transition-delay: 300ms;
  }
  .bars em {
    position: absolute;
    bottom: calc(100% + 0.3rem);
    left: 0;
    right: 0;
    text-align: center;
    font-style: normal;
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tile--diary {
      grid-column: span 2;
      grid-row: auto;
    }
    .tile--stage,
    .tile--retention,
    .tile--offer,
    .tile--earn {
      grid-column: span 1;
      grid-row: auto;
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .tile--diary,
    .tile--stage,
    .tile--retention,
    .tile--offer,
    .tile--earn {
      grid-column: auto;
    }
    .bento__head {
      display: block;
    }
    .bento__pause {
      margin: -1.5rem 0 1.5rem;
    }
    .mini-diary__card {
      font-size: 0.75rem;
      padding: 0.5rem;
    }
  }
</style>
