---
// Clinic OS bento: small live UIs built in code, not video.
const focus = [
  { t: "48 patients overdue for a treatment", d: "Send a recall before the effect wears off", c: "var(--aftercare)" },
  { t: "Only 12% of new patients return", d: "Book the follow-up before they leave", c: "var(--butter-deep)" },
  { t: "24 patients last seen 3–6 months ago", d: "A short check-in keeps them on the books", c: "var(--arrived)" },
  { t: "63 patients not seen for 6 months", d: "Worth one win-back offer", c: "var(--success)" },
];
const funnel = [
  { k: "Enquiries", v: 100, n: 124 },
  { k: "Booked", v: 68, n: 84 },
  { k: "Consulted", v: 52, n: 64 },
  { k: "Treated", v: 41, n: 51 },
];
const kpis = [
  { who: "Dr Rahman", v: 92, a: "90%" },
  { who: "Dr Whitfield", v: 80, a: "87%" },
  { who: "Dr Osei", v: 48, a: "91%" },
];
const board = [
  { k: "Consultation", n: 4, late: false },
  { k: "Foundation", n: 6, late: true },
  { k: "Build & support", n: 7, late: false },
  { k: "Results", n: 3, late: false },
];
const access = ["Patient records", "Clinical photos", "Insights", "Performance"];
const accessOn = [
  [1, 1, 1],
  [1, 0, 1],
  [1, 1, 0],
  [1, 0, 0],
];
---

<section class="bento section" id="clinics" aria-labelledby="bento-title">
  <div class="wrap">
    <div class="bento__head">
      <div class="section-head">
        <p class="eyebrow">Clinic OS</p>
        <h2 id="bento-title" class="display" data-lines>
          <span class="line-mask"><span>Everything the clinic runs on,</span></span>
          <span class="line-mask"><span><em>moving together.</em></span></span>
        </h2>
      </div>
      <button class="bento__pause" type="button" data-motion-toggle aria-pressed="false">Pause motion</button>
    </div>

    <div class="grid">
      <article class="tile tile--diary glass" data-light data-reveal>
        <h3>Diary</h3>
        <p>Day, week and month views across practitioners. Quiet hours fold away, so the time you're actually working stays in focus. Drag to rebook; the patient hears about it.</p>
        <div class="mini-diary" aria-hidden="true">
          {["Dr Osei", "Dr Rahman", "Dr Whitfield"].map((p) => (
            <div class="mini-diary__col"><span>{p}</span><i /><i /><i /></div>
          ))}
          <div class="mini-diary__card"><b>11:15</b> Skin peel</div>
          <span class="mini-diary__fold">2 quiet hours folded away</span>
        </div>
      </article>

      <article class="tile tile--focus glass" data-light data-reveal data-inview style="--d: 80ms">
        <h3>Where to focus</h3>
        <p>Every day, the clinic's retention signals become a short list of next moves. Each one opens the patients to contact.</p>
        <div class="focus" aria-hidden="true">
          {focus.map((f, i) => (
            <div class="focus__row" style={`--i:${i}; --c:${f.c}`}>
              <i></i>
              <div><b>{f.t}</b><small>{f.d}</small></div>
            </div>
          ))}
        </div>
      </article>

      <article class="tile tile--funnel glass" data-light data-reveal data-inview style="--d: 160ms">
        <h3>Insights</h3>
        <p>Follow every lead from website enquiry to treated patient, see which channel brought them in, and which treatments and products actually sell.</p>
        <div class="funnel" aria-hidden="true">
          <div class="funnel__row funnel__head"><span>Enquiry to treated</span><span></span><em>This month</em></div>
          {funnel.map((f, i) => (
            <div class="funnel__row" style={`--w:${f.v}%; --i:${i}`}><span>{f.k}</span><i></i><em>{f.n}</em></div>
          ))}
          <div class="sources">
            <div class="sources__bar"><i style="--w:52%; --c: var(--butter-deep)"></i><i style="--w:31%; --c: var(--aftercare)"></i><i style="--w:17%; --c: var(--mint)"></i></div>
            <div class="sources__key"><span style="--c: var(--butter-deep)">Website 52%</span><span style="--c: var(--aftercare)">Instagram 31%</span><span style="--c: var(--mint)">Referral 17%</span></div>
          </div>
        </div>
      </article>

      <article class="tile tile--alert glass" data-light data-reveal data-inview style="--d: 80ms">
        <h3>Alert the team</h3>
        <p>Running late, or need a hand with a patient right now? One tap sends an urgent alert that pops up on your colleagues' screens, ready to acknowledge or answer.</p>
        <div class="alert" aria-hidden="true">
          <div class="alert__pop">
            <span class="alert__k"><i></i>Urgent · Dr Rahman</span>
            <b>Patient feeling faint after treatment. Can someone come through?</b>
            <div class="alert__btns"><span class="alert__ok">Acknowledge</span><span>Reply</span></div>
          </div>
          <span class="alert__done">✓ Sofia is on her way</span>
        </div>
      </article>

      <article class="tile tile--kpi glass" data-light data-reveal data-inview style="--d: 160ms">
        <h3>Practitioner KPIs</h3>
        <p>Revenue, treatments, attendance and retention for each practitioner, with commission worked out.</p>
        <div class="kpis" aria-hidden="true">
          <div class="kpis__row kpis__head"><span></span><span>Revenue</span><span>Attendance</span></div>
          {kpis.map((k, i) => (
            <div class="kpis__row" style={`--w:${k.v}%; --i:${i}`}><span>{k.who}</span><i></i><em>{k.a}</em></div>
          ))}
        </div>
      </article>

      <article class="tile tile--board glass" data-light data-reveal data-inview style="--d: 80ms">
        <h3>Every patient on a journey board</h3>
        <p>Patients on a plan, grouped by stage, with late steps flagged before anyone has to ask.</p>
        <div class="board" aria-hidden="true">
          {board.map((c, i) => (
            <div class="board__col" style={`--i:${i}`}>
              <span>{c.k} <b>{c.n}</b></span>
              <i></i>
              <i class={c.late ? "late" : ""}></i>
              {i < 3 && <i></i>}
            </div>
          ))}
        </div>
      </article>

      <article class="tile tile--access glass" data-light data-reveal data-inview style="--d: 160ms">
        <h3>Access you control</h3>
        <p>Choose exactly what managers, practitioners and front desk can see, down to a single tab of the patient record.</p>
        <div class="access" aria-hidden="true">
          <span></span><b>Manager</b><b>Practitioner</b><b>Front desk</b>
          {access.map((row, r) => (
            <Fragment>
              <span>{row}</span>
              {accessOn[r].map((on, c) => <i class={on ? "on" : ""} style={`--i:${r * 3 + c}`}></i>)}
            </Fragment>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .bento__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }
  .bento__pause {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid var(--edge-2);
    background: var(--glass-2);
    border-radius: 999px;
    padding: 0.45rem 0.95rem;
    cursor: pointer;
    font-size: 0.85rem;
    flex: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(15rem, auto);
    gap: 1.1rem;
  }
  .tile {
    padding: 1.5rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .tile h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.7rem;
    line-height: 1.05;
  }
  .tile p {
    margin: 0 0 0.8rem;
    color: var(--ink-2);
    font-size: 0.95rem;
    max-width: 28rem;
  }
  .tile--diary {
    grid-column: span 4;
    grid-row: span 2;
  }
  .tile--focus {
    grid-column: span 2;
    grid-row: span 2;
  }
  .tile--funnel,
  .tile--alert,
  .tile--kpi {
    grid-column: span 2;
  }
  .tile--board,
  .tile--access {
    grid-column: span 3;
  }

  /* Diary */
  .mini-diary {
    position: relative;
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
    min-height: 16rem;
    margin-top: 0.5rem;
  }
  .mini-diary__col {
    display: grid;
    grid-template-rows: auto repeat(3, 1fr);
    gap: 0.5rem;
    padding: 0.6rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--edge);
  }
  .mini-diary__col span {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-3);
  }
  .mini-diary__col i {
    border-radius: 10px;
    background: repeating-linear-gradient(0deg, rgba(47, 63, 102, 0.05) 0 1px, transparent 1px 14px);
  }
  .mini-diary__col:nth-child(1) i:nth-of-type(1),
  .mini-diary__col:nth-child(3) i:nth-of-type(3) {
    background: color-mix(in srgb, var(--mint) 50%, white);
    border-left: 3px solid var(--mint);
  }
  .mini-diary__col:nth-child(2) i:nth-of-type(3) {
    background: color-mix(in srgb, var(--aftercare) 35%, white);
    border-left: 3px solid var(--aftercare);
  }
  .mini-diary__card {
    position: absolute;
    left: 0.6rem;
    top: 46%;
    width: calc(33.33% - 1.7rem);
    padding: 0.7rem 0.8rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--butter) 55%, white);
    border-left: 3px solid var(--butter-deep);
    box-shadow: var(--shadow-lift);
    font-size: 0.85rem;
    animation: rebook 9s var(--ease-dew) infinite;
  }
  .mini-diary__card b {
    display: block;
    font-size: 0.72rem;
    color: var(--ink-3);
  }
  @keyframes rebook {
    0%,
    22% {
      transform: translateX(0) rotate(0);
    }
    30% {
      transform: translateX(35%) translateY(-6px) rotate(2deg);
    }
    40%,
    62% {
      transform: translateX(calc(100% + 1.95rem)) rotate(0);
    }
    70% {
      transform: translateX(calc(150% + 2rem)) translateY(-6px) rotate(-2deg);
    }
    80%,
    100% {
      transform: translateX(calc(200% + 3.9rem)) rotate(0);
    }
  }

  .mini-diary__fold {
    position: absolute;
    left: 16.66%;
    bottom: 16%;
    transform: translateX(-50%);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px dashed rgba(47, 63, 102, 0.2);
    font-size: 0.72rem;
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* Where to focus */
  .focus {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.3rem;
  }
  .focus__row {
    display: flex;
    gap: 0.65rem;
    padding: 0.65rem 0.75rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--edge);
    opacity: 0;
    transform: translateY(10px);
  }
  .focus__row i {
    flex: none;
    width: 9px;
    height: 9px;
    margin-top: 0.35rem;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 25%, transparent);
  }
  .focus__row b {
    display: block;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .focus__row small {
    font-size: 0.76rem;
    color: var(--ink-3);
  }
  .tile--focus.is-in .focus__row {
    opacity: 1;
    transform: none;
    transition: all 700ms var(--ease-dew) calc(300ms + var(--i) * 220ms);
  }
  .tile--focus.is-in .focus__row:first-child {
    animation: focus-glow 6s var(--ease-dew) 2s infinite;
  }
  @keyframes focus-glow {
    0%,
    100% {
      box-shadow: none;
    }
    20%,
    60% {
      box-shadow: 0 0 0 2px var(--butter), var(--shadow-lift);
    }
  }

  /* Insights */
  .sources {
    display: grid;
    gap: 0.45rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--edge-2);
  }
  .sources__bar {
    display: flex;
    gap: 3px;
    height: 0.55rem;
  }
  .sources__bar i {
    width: var(--w);
    border-radius: 4px;
    background: var(--c);
  }
  .sources__key {
    display: flex;
    justify-content: space-between;
    gap: 0.4rem;
  }
  .sources__key span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: var(--ink-2);
  }
  .sources__key span::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c);
  }

  /* Alert the team */
  .alert {
    position: relative;
    margin-top: auto;
    min-height: 8.6rem;
  }
  .alert__pop {
    display: grid;
    gap: 0.45rem;
    padding: 0.85rem 0.95rem;
    border-radius: 16px;
    background: #fff;
    border: 1px solid rgba(239, 155, 196, 0.6);
    box-shadow: 0 16px 34px -16px rgba(163, 69, 110, 0.45);
    font-size: 0.82rem;
    opacity: 0;
    transform: translateY(14px) scale(0.97);
  }
  .alert__k {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--aftercare-ink);
  }
  .alert__k i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e0548a;
  }
  .alert__pop b {
    font-weight: 600;
    line-height: 1.3;
  }
  .alert__btns {
    display: flex;
    gap: 0.4rem;
  }
  .alert__btns span {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(47, 63, 102, 0.12);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .alert__btns .alert__ok {
    background: var(--butter);
    border-color: transparent;
  }
  .alert__done {
    position: absolute;
    right: 0.4rem;
    bottom: -0.2rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(166, 220, 205, 0.6);
    color: var(--success-ink);
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0;
  }
  .tile--alert.is-in .alert__pop {
    animation: alert-in 7s var(--ease-dew) 0.4s infinite;
  }
  .tile--alert.is-in .alert__done {
    animation: alert-done 7s var(--ease-dew) 0.4s infinite;
  }
  @keyframes alert-in {
    0% {
      opacity: 0;
      transform: translateY(14px) scale(0.97);
    }
    8%,
    88% {
      opacity: 1;
      transform: none;
    }
    12%,
    20% {
      box-shadow: 0 0 0 4px rgba(239, 155, 196, 0.35), 0 16px 34px -16px rgba(163, 69, 110, 0.45);
    }
    100% {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @keyframes alert-done {
    0%,
    40% {
      opacity: 0;
      transform: translateY(6px);
    }
    48%,
    88% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  /* Insights funnel */
  .funnel {
    margin-top: 0.4rem;
    display: grid;
    gap: 0.6rem;
    padding: 0.9rem 1rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--edge);
  }
  .funnel__row {
    display: grid;
    grid-template-columns: 4.6rem 1fr 1.8rem;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    color: var(--ink-3);
  }
  .funnel__row em {
    font-style: normal;
    text-align: right;
    font-weight: 600;
    color: var(--ink);
  }
  .funnel__head {
    grid-template-columns: 1fr auto;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .funnel__head span:nth-child(2) {
    display: none;
  }
  .funnel__head em {
    font-weight: 400;
    color: var(--ink-3);
  }
  .funnel__row i {
    height: 0.6rem;
    width: 0;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--butter), var(--butter-deep));
  }
  .funnel__row:nth-last-child(2) i {
    background: linear-gradient(90deg, var(--mint), var(--success));
  }
  .tile--funnel.is-in .funnel__row i {
    width: var(--w);
    transition: width 1s var(--ease-dew) calc(200ms + var(--i) * 180ms);
  }

  /* Practitioner KPIs */
  .kpis {
    margin-top: 0.4rem;
    display: grid;
    gap: 0.7rem;
    padding: 0.9rem 1rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--edge);
  }
  .kpis__head {
    font-size: 0.68rem !important;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3) !important;
  }
  .kpis__head span:last-child {
    text-align: right;
  }
  .kpis__row {
    display: grid;
    grid-template-columns: 5.4rem 1fr auto;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    color: var(--ink-2);
  }
  .kpis__row i {
    height: 0.6rem;
    width: 0;
    border-radius: 6px;
    background: var(--arrived);
  }
  .kpis__row em {
    font-style: normal;
    font-weight: 600;
    color: var(--success-ink);
  }
  .tile--kpi.is-in .kpis__row i {
    width: var(--w);
    transition: width 1s var(--ease-dew) calc(200ms + var(--i) * 160ms);
  }

  /* Journey board */
  .board {
    margin-top: auto;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .board__col {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 0.55rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--edge);
    min-height: 7.5rem;
  }
  .board__col span {
    font-size: 0.72rem;
    color: var(--ink-3);
    font-weight: 600;
  }
  .board__col span b {
    color: var(--ink);
  }
  .board__col i {
    height: 1.4rem;
    border-radius: 8px;
    background: linear-gradient(90deg, var(--butter-deep) 0 3px, rgba(255, 255, 255, 0.95) 3px);
    box-shadow: 0 1px 2px rgba(47, 63, 102, 0.08);
    opacity: 0;
    transform: translateY(6px);
  }
  .board__col i.late {
    background: linear-gradient(90deg, var(--aftercare) 0 3px, rgba(255, 238, 246, 0.95) 3px);
  }
  .tile--board.is-in .board__col i {
    opacity: 1;
    transform: none;
    transition: all 600ms var(--ease-dew) calc(250ms + var(--i) * 150ms);
  }
  .tile--board.is-in .board__col i.late {
    animation: late 3s ease-in-out 1.5s infinite;
  }
  @keyframes late {
    50% {
      box-shadow: 0 0 0 3px rgba(239, 155, 196, 0.45);
    }
  }

  /* Access grid */
  .access {
    margin-top: auto;
    display: grid;
    grid-template-columns: 1fr repeat(3, 4.6rem);
    align-items: center;
    row-gap: 0.45rem;
    font-size: 0.76rem;
    color: var(--ink-2);
  }
  .access b {
    font-weight: 600;
    font-size: 0.68rem;
    color: var(--ink-3);
    text-align: center;
  }
  .access i {
    justify-self: center;
    position: relative;
    width: 1.9rem;
    height: 1.05rem;
    border-radius: 999px;
    background: rgba(47, 63, 102, 0.12);
    transition: background 400ms var(--ease-dew) calc(300ms + var(--i) * 70ms);
  }
  .access i::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: calc(1.05rem - 4px);
    height: calc(1.05rem - 4px);
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgba(47, 63, 102, 0.25);
    transition: transform 400ms var(--ease-dew) calc(300ms + var(--i) * 70ms);
  }
  .tile--access.is-in .access i.on {
    background: var(--butter-deep);
  }
  .tile--access.is-in .access i.on::after {
    transform: translateX(0.85rem);
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tile--diary {
      grid-column: span 2;
      grid-row: auto;
    }
    .tile--focus,
    .tile--funnel,
    .tile--alert,
    .tile--kpi,
    .tile--board,
    .tile--access {
      grid-column: span 1;
      grid-row: auto;
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .tile--diary,
    .tile--focus,
    .tile--funnel,
    .tile--alert,
    .tile--kpi,
    .tile--board,
    .tile--access {
      grid-column: auto;
    }
    .bento__head {
      display: block;
    }
    .bento__pause {
      margin: -1.5rem 0 1.5rem;
    }
    .mini-diary__card {
      font-size: 0.75rem;
      padding: 0.5rem;
    }
  }
</style>
