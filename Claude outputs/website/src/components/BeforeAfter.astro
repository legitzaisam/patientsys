---
// Before and after, skin-quality treatments only (never toxin results, per
// ASA/CAP). Until permissioned patient photos exist, both sides are generated
// skin renders, labelled as illustrations. Tone rotates through the full ramp.
const tones = [
  { name: "Porcelain", v: "#f3dccb" },
  { name: "Light", v: "#e8c2a6" },
  { name: "Medium", v: "#cf9c78" },
  { name: "Tan", v: "#b07a55" },
  { name: "Deep", v: "#7e4f36" },
  { name: "Rich", v: "#5a3626" },
];
---

<section class="ba section" aria-labelledby="ba-title">
  <div class="wrap ba__grid">
    <div class="ba__copy">
      <p class="eyebrow">Progress, honestly shown</p>
      <h2 id="ba-title" class="display" data-lines>
        <span class="line-mask"><span>Results that are</span></span>
        <span class="line-mask"><span><em>theirs</em> to share.</span></span>
      </h2>
      <p class="lede">
        Patients see their own before and after on their plan. Nothing reaches a website or a campaign without written
        consent stored on their record, and results are never filtered or retouched.
      </p>
      <ul class="ba__facts">
        <li><b>Skin-quality treatments</b> such as microneedling, peels and laser</li>
        <li><b>Consent on file</b> for every image, with the right to withdraw</li>
        <li><b>Unfiltered</b>, same light, same angle</li>
      </ul>
      <div class="ba__tones" role="radiogroup" aria-label="Skin tone of the illustration">
        {tones.map((t, i) => (
          <button role="radio" aria-checked={i === 2 ? "true" : "false"} aria-label={t.name} style={`--t:${t.v}`} data-tone={t.v} />
        ))}
      </div>
    </div>

    <figure class="ba__figure" data-ba>
      <div class="ba__frame glass">
        <canvas class="ba__img ba__img--after" width="720" height="540" data-after aria-hidden="true"></canvas>
        <div class="ba__clip" data-clip>
          <canvas class="ba__img" width="720" height="540" data-before aria-hidden="true"></canvas>
        </div>
        <div class="ba__handle" data-handle aria-hidden="true"><span>⟷</span></div>
        <span class="ba__tag ba__tag--l">Before</span>
        <span class="ba__tag ba__tag--r">12 weeks later</span>
        <span class="ba__sweep" data-sweep></span>
        <input class="ba__range" type="range" min="0" max="100" value="50" aria-label="Compare before and after" data-range />
      </div>
      <figcaption>
        <span class="ba__badge">Illustration</span>
        Microneedling, three sessions. A generated render, not a patient; real results appear only with written consent.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .ba__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .ba__copy {
    display: grid;
    gap: 1.2rem;
  }
  .ba__facts {
    list-style: none;
    padding: 0;
    margin: 0.4rem 0 0;
    display: grid;
    gap: 0.6rem;
    color: var(--ink-2);
  }
  .ba__facts li {
    padding-left: 1.4rem;
    position: relative;
  }
  .ba__facts li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--butter);
    box-shadow: 0 0 0 4px var(--butter-soft);
  }
  .ba__facts b {
    color: var(--ink);
    font-weight: 600;
  }
  .ba__tones {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }
  .ba__tones button {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 2px solid var(--edge);
    background: var(--t);
    cursor: pointer;
    box-shadow: var(--shadow-glass);
    transition: transform var(--t-micro);
  }
  .ba__tones button[aria-checked="true"] {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .ba__tones button:hover {
    transform: scale(1.1);
  }
  .ba__figure {
    margin: 0;
  }
  .ba__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    padding: 0;
    border-radius: 22px;
    box-shadow: var(--shadow-deep);
    touch-action: pan-y;
  }
  .ba__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ba__clip {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--x, 50%)) 0 0);
  }
  .ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--x, 50%);
    width: 2px;
    margin-left: -1px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 12px rgba(47, 63, 102, 0.3);
    pointer-events: none;
  }
  .ba__handle span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.6rem;
    height: 2.6rem;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--glass);
    border: 1px solid var(--edge);
    box-shadow: var(--shadow-lift);
    font-size: 0.95rem;
  }
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .ba__range:focus-visible + .ba__handle,
  .ba__frame:has(.ba__range:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .ba__tag {
    position: absolute;
    bottom: 1rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.78);
    font-size: 0.78rem;
    font-weight: 600;
    pointer-events: none;
  }
  .ba__tag--l {
    left: 1rem;
  }
  .ba__tag--r {
    right: 1rem;
  }
  .ba__sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(100deg, transparent 35%, rgba(255, 250, 235, 0.55) 50%, transparent 65%);
    transform: translateX(-100%);
  }
  .ba__sweep.is-on {
    transform: translateX(100%);
    transition: transform 1.1s var(--ease-dew);
  }
  figcaption {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--ink-3);
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }
  .ba__badge {
    flex: none;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--butter-soft);
    color: var(--butter-ink);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .ba__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Procedural skin: fractal value noise for texture and tone variation,
  // pores as small darker dots, and uneven patches only on the "before" side.
  function hash(x: number, y: number, s: number) {
    let h = x * 374761393 + y * 668265263 + s * 982451653;
    h = (h ^ (h >>> 13)) * 1274126177;
    return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
  }
  function noise(x: number, y: number, s: number) {
    const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi;
    const u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);
    const a = hash(xi, yi, s), b = hash(xi + 1, yi, s), c = hash(xi, yi + 1, s), d = hash(xi + 1, yi + 1, s);
    return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
  }
  function fbm(x: number, y: number, s: number, oct = 4) {
    let f = 0, amp = 0.5, fr = 1;
    for (let i = 0; i < oct; i++) {
      f += amp * noise(x * fr, y * fr, s + i);
      fr *= 2.03;
      amp *= 0.5;
    }
    return f;
  }
  function hex(h: string) {
    const n = parseInt(h.slice(1), 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }

  function paint(canvas: HTMLCanvasElement, tone: string, before: boolean) {
    const w = 360, h = 270; // rendered at half size, upscaled smoothly
    const off = document.createElement("canvas");
    off.width = w;
    off.height = h;
    const ctx = off.getContext("2d")!;
    const img = ctx.createImageData(w, h);
    const [r0, g0, b0] = hex(tone);
    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        const fine = fbm(x / 6, y / 6, 11, 3);
        const broad = fbm(x / 70, y / 70, 3, 4);
        let shade = 1 + (fine - 0.5) * (before ? 0.16 : 0.06);
        // Soft studio light from the top left.
        shade *= 1.08 - (x / w) * 0.1 - (y / h) * 0.12;
        let rr = r0 * shade, gg = g0 * shade, bb = b0 * shade;
        if (before) {
          // Uneven tone: warmer, darker patches and a little redness.
          const patch = Math.max(0, broad - 0.52) * 2.2;
          rr *= 1 - patch * 0.1;
          gg *= 1 - patch * 0.2;
          bb *= 1 - patch * 0.24;
          const red = Math.max(0, fbm(x / 40, y / 40, 7) - 0.58) * 1.6;
          gg *= 1 - red * 0.12;
          bb *= 1 - red * 0.1;
        } else {
          // Healthy sheen.
          const sheen = Math.max(0, 1 - Math.hypot(x / w - 0.32, y / h - 0.3) * 2.4);
          rr += sheen * 18;
          gg += sheen * 16;
          bb += sheen * 14;
        }
        const i = (y * w + x) * 4;
        img.data[i] = rr;
        img.data[i + 1] = gg;
        img.data[i + 2] = bb;
        img.data[i + 3] = 255;
      }
    }
    ctx.putImageData(img, 0, 0);
    // Pores and fine texture.
    const count = before ? 1400 : 700;
    for (let k = 0; k < count; k++) {
      const x = hash(k, 1, 5) * w, y = hash(k, 2, 5) * h;
      const s = (before ? 0.6 : 0.45) + hash(k, 3, 5) * (before ? 0.9 : 0.4);
      ctx.fillStyle = `rgba(60,30,15,${before ? 0.09 : 0.05})`;
      ctx.beginPath();
      ctx.ellipse(x, y, s, s * 0.8, 0, 0, Math.PI * 2);
      ctx.fill();
    }
    const out = canvas.getContext("2d")!;
    out.imageSmoothingQuality = "high";
    out.drawImage(off, 0, 0, canvas.width, canvas.height);
  }

  const fig = document.querySelector<HTMLElement>("[data-ba]")!;
  const beforeC = fig.querySelector<HTMLCanvasElement>("[data-before]")!;
  const afterC = fig.querySelector<HTMLCanvasElement>("[data-after]")!;
  const range = fig.querySelector<HTMLInputElement>("[data-range]")!;
  const sweep = fig.querySelector<HTMLElement>("[data-sweep]")!;
  const frame = fig.querySelector<HTMLElement>(".ba__frame")!;

  function render(tone: string) {
    paint(beforeC, tone, true);
    paint(afterC, tone, false);
  }
  const setX = (v: number) => frame.style.setProperty("--x", `${v}%`);
  range.addEventListener("input", () => setX(Number(range.value)));
  range.addEventListener("change", () => {
    sweep.classList.remove("is-on");
    void sweep.offsetWidth;
    sweep.classList.add("is-on");
  });

  document.querySelectorAll<HTMLButtonElement>("[data-tone]").forEach((b, _, all) => {
    b.addEventListener("click", () => {
      all.forEach((x) => x.setAttribute("aria-checked", String(x === b)));
      render(b.dataset.tone!);
    });
  });

  // Paint when it first nears the viewport.
  const io = new IntersectionObserver(
    ([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const checked = document.querySelector<HTMLButtonElement>('[data-tone][aria-checked="true"]');
      render(checked?.dataset.tone || "#cf9c78");
    },
    { rootMargin: "400px" },
  );
  io.observe(fig);
</script>
