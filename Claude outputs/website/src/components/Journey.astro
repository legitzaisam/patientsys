---
// The journey: a pinned scroll story. A device frame stays put while a gold
// thread advances through five chapters, each a coded screen (JourneyScreen).
// Phones and reduced motion get the same chapters as a simple stacked list.
import JourneyScreen from "./JourneyScreen.astro";
type Chapter = {
  k: string;
  title: string;
  body: string;
  side: "Clinic" | "Patient";
  url: string;
  shot?: string;
  ui?: "book" | "treat" | "aftercare" | "progress" | "return";
};
const chapters: Chapter[] = [
  {
    k: "Book",
    title: "Booked, and already known.",
    body: "Appointments land in a shared diary by practitioner and treatment, and move live from booked to complete. Front desk sees who has arrived, who is waiting and what is due.",
    ui: "book",
    side: "Clinic",
    url: "diary",
  },
  {
    k: "Treat",
    title: "One record, the whole journey.",
    body: "Every treatment syncs from the clinic's record into the patient's own portal. A one-off appointment arrives with its notes, photos and aftercare, ready for the patient at home. A course of treatments becomes a mapped-out skin plan, so the clinic and the patient can follow every step, see what's next and track progress together.",
    ui: "treat",
    side: "Clinic",
    url: "patients / grace / overview",
  },
  {
    k: "Aftercare",
    title: "Looked after between visits.",
    body: "Patients get a daily skincare routine with reminders, a quick recovery check-in their practitioner can see, and an AI assistant that answers aftercare questions using their own treatment plan.",
    ui: "aftercare",
    side: "Patient",
    url: "my-record / plan",
  },
  {
    k: "Progress",
    title: "A roadmap they're in control of.",
    body: "A personal, step-by-step plan they tick off as they go, so there's no grey area about what comes next. Life happens: patients can ask to pause, and the request goes straight to their practitioner to approve.",
    ui: "progress",
    side: "Patient",
    url: "my-record / timeline",
  },
  {
    k: "Return",
    title: "A reason to come back.",
    body: "Design your own offer templates and switch one on for each stage of the journey, and they send themselves. Patients find their offer waiting in their own portal and can book with one tap.",
    ui: "return",
    side: "Clinic",
    url: "offers",
  },
];
const n = chapters.length;
const pad = (i: number) => String(i).padStart(2, "0");
const words = ["Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven"];
const dotX = (i: number) => 10 + (i * 580) / (n - 1);
---

<section class="journey" id="journey" aria-labelledby="journey-title" data-journey>
  <div class="journey__intro wrap section-head">
    <p class="eyebrow">The journey</p>
    <h2 id="journey-title" class="display" data-lines>
      <span class="line-mask"><span>{words[n]} moments.</span></span>
      <span class="line-mask"><span>One <em>golden thread.</em></span></span>
    </h2>
    <p class="lede">Follow one patient from the first booking to the return visit, across the clinic and patient portals. Everything below runs on demo data.</p>
  </div>

  <div class="journey__track" data-journey-track style={`--n:${n}`}>
    <div class="journey__stage">
      <div class="wrap journey__grid">
        <div class="journey__text">
          <div class="journey__count" aria-hidden="true">
            <span class="journey__roll" data-roll>
              {chapters.map((_, i) => <span>{pad(i + 1)}</span>)}
            </span>
            <span class="journey__of">/ {pad(n)}</span>
          </div>
          <ol class="journey__chapters">
            {chapters.map((c, i) => (
              <li class="chapter" data-chapter={i} aria-current={i === 0 ? "step" : undefined}>
                <p class="chapter__k"><span class={`chapter__side chapter__side--${c.side.toLowerCase()}`}>{c.side}</span>{c.k}</p>
                <h3 class="chapter__t">{c.title}</h3>
                <p class="chapter__b">{c.body}</p>
                <figure class="chapter__shot" aria-label={`${c.side} portal: ${c.k.toLowerCase()} screen`}>
                  {c.shot ? (
                    <img src={`/img/shots/${c.shot}-800.webp`} alt={`${c.side} portal: ${c.k.toLowerCase()} screen`} loading="lazy" width="800" height="500" />
                  ) : (
                    <div class="chapter__ui" aria-hidden="true"><JourneyScreen kind={c.ui!} /></div>
                  )}
                </figure>
              </li>
            ))}
          </ol>
        </div>

        <div class="journey__device" aria-hidden="true">
          <div class="device glass">
            <div class="device__bar"><i></i><i></i><i></i></div>
            <div class="device__screen">
              {chapters.map((c, i) =>
                c.shot ? (
                  <img
                    class="device__img"
                    data-shot={i}
                    data-url={c.url}
                    src={`/img/shots/${c.shot}-1600.webp`}
                    srcset={`/img/shots/${c.shot}-800.webp 800w, /img/shots/${c.shot}-1600.webp 1600w`}
                    sizes="(max-width: 1200px) 55vw, 700px"
                    alt=""
                    loading={i < 2 ? "eager" : "lazy"}
                    width="1600"
                    height="1000"
                  />
                ) : (
                  <div class="device__img" data-shot={i} data-url={c.url}><JourneyScreen kind={c.ui!} /></div>
                ),
              )}
            </div>
          </div>
          <svg class="thread" viewBox="0 0 600 40" aria-hidden="true">
            <path d="M10 20 H590" class="thread__base"></path>
            <path d="M10 20 H590" class="thread__fill" pathLength="1" data-thread-fill></path>
            {chapters.map((_, i) => <circle cx={dotX(i)} cy="20" r="6" class="thread__dot" data-dot={i}></circle>)}
          </svg>
          <ol class="thread__labels">
            {chapters.map((c, i) => <li style={`left:${(dotX(i) / 600) * 100}%`}>{c.k}</li>)}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .journey {
    position: relative;
    padding-top: clamp(4.5rem, 10vw, 9rem);
  }
  .journey__intro {
    margin-bottom: 2rem;
  }

  /* ---------- Pinned (desktop, motion allowed) ---------- */
  .journey__track {
    position: relative;
    /* One equal scroll segment per chapter, plus the pinned screen itself. */
    height: calc(var(--n, 5) * 90vh + 100vh);
  }
  .journey__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    align-items: center;
    overflow: hidden;
  }
  .journey__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .journey__count {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(4rem, 7vw, 6.5rem);
    line-height: 1;
    height: 1em;
    overflow: hidden;
    margin-bottom: 1.2rem;
    font-variant-numeric: tabular-nums;
  }
  .journey__roll {
    display: grid;
    transition: transform 700ms var(--ease-dew);
    transform: translateY(calc(var(--step, 0) * -1em));
    color: var(--butter-ink);
  }
  .journey__roll span {
    height: 1em;
  }
  .journey__of {
    font-size: 0.32em;
    color: var(--ink-3);
    font-family: var(--font-sans);
  }
  .journey__chapters {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .chapter {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(26px);
    clip-path: inset(0 0 100% 0);
    transition:
      opacity 600ms var(--ease-dew),
      transform 800ms var(--ease-dew),
      clip-path 800ms var(--ease-peel);
    pointer-events: none;
  }
  .chapter[aria-current] {
    opacity: 1;
    transform: none;
    clip-path: inset(0 0 -10% 0);
    pointer-events: auto;
  }
  .chapter__k {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  .chapter__side {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
  .chapter__side--clinic {
    background: rgba(143, 199, 234, 0.3);
    color: var(--arrived-ink);
  }
  .chapter__side--patient {
    background: rgba(239, 155, 196, 0.28);
    color: var(--aftercare-ink);
  }
  .chapter__t {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 3.4vw, 3.1rem);
    line-height: 1.02;
    margin: 0 0 1rem;
  }
  .chapter__b {
    margin: 0;
    color: var(--ink-2);
    max-width: 30rem;
  }
  .chapter__shot {
    display: none;
  }

  .device {
    padding: 0;
    overflow: hidden;
    border-radius: 18px;
    background: var(--glass);
    box-shadow: var(--shadow-deep);
  }
  .device__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 2.8rem;
    box-sizing: border-box;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--edge-2);
  }
  .device__bar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.12);
  }
  .device__bar i:nth-child(2) {
    background: #febc2e;
  }
  .device__bar i:nth-child(3) {
    background: #28c840;
  }
  .device__bar span {
    margin: 0 auto;
    padding: 0.2rem 0.9rem;
    border-radius: 999px;
    background: rgba(47, 63, 102, 0.05);
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .device__screen {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #fff;
    container-type: inline-size;
  }
  .chapter__ui {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--edge);
    box-shadow: var(--shadow-lift);
    container-type: inline-size;
  }
  .device__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    opacity: 0;
    clip-path: inset(0 0 0 100%);
    transform: scale(1.03);
    transition:
      clip-path 900ms var(--ease-peel),
      opacity 400ms ease,
      transform 1200ms var(--ease-dew);
  }
  .device__img.is-active {
    opacity: 1;
    clip-path: inset(0 0 0 0);
    transform: none;
    z-index: 1;
  }
  .device__img.is-prev {
    opacity: 1;
  }

  .thread {
    width: 100%;
    height: auto;
    aspect-ratio: 15 / 1;
    margin-top: 1.4rem;
    overflow: visible;
  }
  .thread__base {
    stroke: rgba(47, 63, 102, 0.12);
    stroke-width: 2;
  }
  .thread__fill {
    stroke: var(--butter-deep);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--p, 0));
    transition: stroke-dashoffset 160ms linear;
    filter: drop-shadow(0 0 6px rgba(226, 196, 107, 0.6));
  }
  .thread__dot {
    fill: var(--background);
    stroke: rgba(47, 63, 102, 0.2);
    stroke-width: 2;
    transition:
      fill var(--t-ui),
      stroke var(--t-ui);
  }
  .thread__dot.is-done {
    fill: var(--butter);
    stroke: var(--butter-deep);
  }
  .thread__labels {
    position: relative;
    height: 1.2rem;
    list-style: none;
    padding: 0;
    margin: 0.3rem 0 0;
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .thread__labels li {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  /* ---------- Stacked (phones, reduced motion, no JS) ---------- */
  :global(html:not(.js)) .journey__track,
  .journey.is-static .journey__track {
    height: auto;
  }
  :global(html:not(.js)) .journey__stage,
  .journey.is-static .journey__stage {
    position: static;
    height: auto;
    padding-bottom: 4rem;
  }
  :global(html:not(.js)) .journey__grid,
  .journey.is-static .journey__grid {
    grid-template-columns: 1fr;
  }
  :global(html:not(.js)) .journey__device,
  :global(html:not(.js)) .journey__count,
  .journey.is-static .journey__device,
  .journey.is-static .journey__count {
    display: none;
  }
  :global(html:not(.js)) .journey__chapters,
  .journey.is-static .journey__chapters {
    gap: 3.5rem;
  }
  :global(html:not(.js)) .chapter,
  .journey.is-static .chapter {
    grid-area: auto;
    opacity: 1;
    transform: none;
    clip-path: none;
    pointer-events: auto;
  }
  :global(html:not(.js)) .chapter__shot,
  .journey.is-static .chapter__shot {
    display: block;
    margin: 1.4rem 0 0;
  }
  .chapter__shot img {
    width: 100%;
    height: auto;
    border-radius: 14px;
    border: 1px solid var(--edge);
    box-shadow: var(--shadow-lift);
  }
</style>

<script>
  import { ScrollTrigger, reducedMotion, getLenis } from "../scripts/motion";

  const root = document.querySelector<HTMLElement>("[data-journey]")!;
  const track = root.querySelector<HTMLElement>("[data-journey-track]")!;
  const chapters = [...root.querySelectorAll<HTMLElement>("[data-chapter]")];
  const shots = [...root.querySelectorAll<HTMLElement>("[data-shot]")];
  const dots = [...root.querySelectorAll<SVGCircleElement>("[data-dot]")];
  const roll = root.querySelector<HTMLElement>("[data-roll]")!;
  const fill = root.querySelector<SVGPathElement>("[data-thread-fill]")!;
  const n = chapters.length;
  let current = -1;

  function show(i: number) {
    if (i === current) return;
    chapters.forEach((c, j) => (j === i ? c.setAttribute("aria-current", "step") : c.removeAttribute("aria-current")));
    shots.forEach((s, j) => {
      s.classList.toggle("is-active", j === i);
      s.classList.toggle("is-prev", j === current);
    });
    dots.forEach((d, j) => d.classList.toggle("is-done", j <= i));
    roll.style.setProperty("--step", String(i));
    current = i;
  }

  // Every chapter owns an equal slice of the scroll. The thread reaches each
  // dot in the middle of its slice, so dot, number, text and screen always
  // change together and the gaps between stages are identical.
  const stepOf = (p: number) => Math.min(n - 1, Math.floor(p * n));
  const threadAt = (p: number) => Math.min(1, Math.max(0, (p * n - 0.5) / (n - 1)));

  const mq = matchMedia("(min-width: 900px)");
  let trigger: ScrollTrigger | null = null;
  let settle = 0;

  // When scrolling stops inside the journey, glide to the centre of the
  // current chapter so each stage comes to rest in the same place.
  function settleToChapter() {
    const lenis = getLenis();
    if (!trigger || !lenis) return;
    const p = trigger.progress;
    if (p <= 0 || p >= 1) return;
    const target = trigger.start + ((stepOf(p) + 0.5) / n) * (trigger.end - trigger.start);
    if (Math.abs(target - window.scrollY) < 4) return;
    lenis.scrollTo(target, { duration: 0.9, easing: (t: number) => 1 - Math.pow(1 - t, 3) });
  }

  function setup() {
    trigger?.kill();
    trigger = null;
    const pinned = mq.matches && !reducedMotion();
    root.classList.toggle("is-static", !pinned);
    if (!pinned) return;
    show(0);
    trigger = ScrollTrigger.create({
      trigger: track,
      start: "top top",
      end: "bottom bottom",
      onUpdate: (self) => {
        const p = self.progress;
        fill.style.setProperty("--p", String(threadAt(p)));
        show(stepOf(p));
        clearTimeout(settle);
        settle = window.setTimeout(settleToChapter, 220);
      },
    });
  }
  setup();
  mq.addEventListener("change", setup);
</script>
