# launch-plan/.env.example
#
# Copy to launch-plan/.env.local and fill in. .env.local is git-ignored, so the
# authtoken never enters the repository. Every script in launch-plan/ reads it.
#
#   cp launch-plan/.env.example launch-plan/.env.local

# ---------------------------------------------------------------------------
# ngrok (required for a public URL)
# ---------------------------------------------------------------------------

# From https://dashboard.ngrok.com/get-started/your-authtoken
# The ngrok agent reads NGROK_AUTHTOKEN directly; nothing is written to disk.
NGROK_AUTHTOKEN=

# Your free dev domain from https://dashboard.ngrok.com/domains
# (Universal Gateway -> Domains), without https://, e.g. aetheria-demo.ngrok-free.dev
NGROK_DOMAIN=

# Optional: protect the whole public URL with a username and password
# (ngrok Traffic Policy basic-auth). Leave both empty for an open demo.
# ngrok requires the password to be 8 to 128 characters.
NGROK_BASIC_AUTH_USER=
NGROK_BASIC_AUTH_PASS=

# ---------------------------------------------------------------------------
# Local ports (chosen so nothing collides with `npm run dev` on 8080)
# ---------------------------------------------------------------------------

# The Aetheria app in demo mode
APP_PORT=8090

# The gateway that ngrok points at: website on "/", app behind it
GATEWAY_PORT=8099

# ---------------------------------------------------------------------------
# How the app runs behind the tunnel
# ---------------------------------------------------------------------------

# preview = production build in demo mode, run with node. About 55 requests
#           per page load. Recommended for anything shared publicly.
# dev     = `vite dev` in demo mode. Hot reload, but about 430 requests per
#           page load, which burns the free plan's 20k requests/month fast.
# If the preview build fails, start-demo.sh falls back to dev automatically.
APP_MODE=preview

# Path from launch-plan/ to the repository root that holds the app.
# Default ".." is correct for the Aetheria-launch worktree.
APP_DIR=..

# Persona used when /demo/enter has no role:
# owner | manager | practitioner | front_desk | patient
DEMO_DEFAULT_ROLE=owner

# The website's /login is the demo's only sign-in page. The gateway redirects
# the app's /auth and /portal there (DEMO_SIGNIN_REDIRECT), and the app itself
# hands Sign out, its landing and its sign-in pages back to DEMO_SIGNIN_URL.
# Set DEMO_SIGNIN_REDIRECT=false and DEMO_SIGNIN_URL= (empty) in front of a live app.
DEMO_SIGNIN_REDIRECT=true
DEMO_SIGNIN_URL=/login

# Pin the demo fixture clock for stable screenshots (optional), e.g.
# 2026-10-01T09:30:00Z. Leave empty to use the real clock.
DEMO_NOW=

# ---------------------------------------------------------------------------
# Own domain through a Cloudflare Tunnel (launch-plan/cloudflare/)
# ---------------------------------------------------------------------------

# The public host, without https://, e.g. www.sqinos.com. When set it wins over
# NGROK_DOMAIN for APP_ORIGIN / PUBLIC_URL. Leave empty for the ngrok path.
PUBLIC_DOMAIN=

# Tunnel credentials, one of:
#  a) a remotely-managed tunnel (Cloudflare dashboard -> Networks -> Tunnels):
#     paste its token here. Nothing else is needed on the Mac.
TUNNEL_TOKEN=
#  b) a locally-managed tunnel (cloudflared tunnel login / create): the config
#     file and tunnel name. See launch-plan/cloudflare/config.example.yml.
TUNNEL_NAME=sqinos
CLOUDFLARED_CONFIG=~/.cloudflared/sqinos.yml
# Tunnel transport: http2 (TCP, robust behind VPNs such as Tailscale) or quic (UDP, faster).
TUNNEL_PROTOCOL=http2

# Public demo safety: when the repo root has a real .env (live Supabase keys),
# these placeholders override it at build time so the public bundle never
# carries the live project URL or keys. cloudflare/doctor.sh insists on them.
VITE_SUPABASE_URL=https://demo.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=demo-placeholder-key
VITE_SUPABASE_PROJECT_ID=demo
SUPABASE_URL=https://demo.invalid
SUPABASE_PUBLISHABLE_KEY=demo-placeholder-key
