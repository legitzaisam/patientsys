---
// Clinic OS bento: small live UIs built in code, not video.
const focus = [
  { t: "48 patients overdue for a treatment", d: "Send a recall before the effect wears off", c: "var(--aftercare)" },
  { t: "Only 12% of new patients return", d: "Book the follow-up before they leave", c: "var(--butter-deep)" },
  { t: "24 patients last seen 3–6 months ago", d: "A short check-in keeps them on the books", c: "var(--arrived)" },
  { t: "63 patients not seen for 6 months", d: "Worth one win-back offer", c: "var(--success)" },
];
const funnel = [
  { k: "Enquiries", v: 100, n: 124 },
  { k: "Booked", v: 68, n: 84 },
  { k: "Consulted", v: 52, n: 64 },
  { k: "Treated", v: 41, n: 51 },
];
const kpis = [
  { who: "Dr Rahman", v: 92, a: "90%" },
  { who: "Dr Whitfield", v: 80, a: "87%" },
  { who: "Dr Osei", v: 48, a: "91%" },
];
const board = [
  { k: "Consultation", n: 4, late: false },
  { k: "Foundation", n: 6, late: true },
  { k: "Build & support", n: 7, late: false },
  { k: "Results", n: 3, late: false },
];
const access = ["Patient records", "Clinical photos", "Insights", "Performance"];
const accessOn = [
  [1, 1, 1],
  [1, 0, 1],
  [1, 1, 0],
  [1, 0, 0],
];
---

<section class="bento section" id="clinics" aria-labelledby="bento-title">
  <div class="wrap">
    <div class="bento__head">
      <div class="section-head">
        <p class="eyebrow">Clinic OS</p>
        <h2 id="bento-title" class="display" data-lines>
          <span class="line-mask"><span>Everything the clinic runs on,</span></span>
          <span class="line-mask"><span><em>moving together.</em></span></span>
        </h2>
      </div>
      <button class="bento__pause" type="button" data-motion-toggle aria-pressed="false">Pause motion</button>
    </div>

    <div class="grid">
      <article class="tile tile--diary glass" data-light data-reveal data-diary>
        <h3>Diary</h3>
        <p>Day, week and month views across practitioners. Needs action lifts the bookings that still need consent or payment — the rest fade in place.</p>
        <div class="mini-diary" aria-hidden="true">
          <div class="mini-diary__stage">
            <div class="mini-diary__canvas" data-diary-canvas>
              {["off", "on", "menu"].map((s) => (
                <img
                  class={`mini-diary__shot mini-diary__shot--${s}`}
                  data-diary-shot={s}
                  src={`/img/shots/diary-live-${s}-800.webp`}
                  srcset={`/img/shots/diary-live-${s}-800.webp 800w, /img/shots/diary-live-${s}-1600.webp 1600w`}
                  sizes="(max-width: 640px) 160vw, (max-width: 1000px) 92vw, 56vw"
                  alt=""
                  width="1600"
                  height="869"
                />
              ))}
              {/* Matched cards in the live capture, as % of the planner. */}
              <i class="mini-diary__ring" data-diary-ring style="--l:7.71%; --t:63.68%"></i>
              <i class="mini-diary__ring" data-diary-ring style="--l:68.57%; --t:55.26%"></i>
              <span class="mini-diary__ripple" data-diary-ripple></span>
              <svg class="mini-diary__cursor" data-diary-cursor viewBox="0 0 24 24" width="22" height="22">
                <path d="M4 2.5 19.5 13l-7 1.2 3.9 7.3-2.7 1.4-3.9-7.4L4 20.4Z" />
              </svg>
            </div>
          </div>
        </div>
      </article>

      <article class="tile tile--focus glass" data-light data-reveal data-inview style="--d: 80ms">
        <h3>Where to focus</h3>
        <p>Every day, the clinic's retention signals become a short list of next moves. Each one opens the patients to contact.</p>
        <div class="focus" aria-hidden="true">
          {focus.map((f, i) => (
            <div class="focus__row" style={`--i:${i}; --c:${f.c}`}>
              <i></i>
              <div><b>{f.t}</b><small>{f.d}</small></div>
            </div>
          ))}
        </div>
      </article>

      <article class="tile tile--funnel glass" data-light data-reveal data-inview style="--d: 160ms">
        <h3>Insights</h3>
        <p>Follow every lead from website enquiry to treated patient, see which channel brought them in, and which treatments and products actually sell.</p>
        <div class="funnel" aria-hidden="true">
          <div class="funnel__row funnel__head"><span>Enquiry to treated</span><span></span><em>This month</em></div>
          {funnel.map((f, i) => (
            <div class="funnel__row" style={`--w:${f.v}%; --i:${i}`}><span>{f.k}</span><i></i><em>{f.n}</em></div>
          ))}
          <div class="sources">
            <div class="sources__bar"><i style="--w:52%; --c: var(--butter-deep)"></i><i style="--w:31%; --c: var(--aftercare)"></i><i style="--w:17%; --c: var(--mint)"></i></div>
            <div class="sources__key"><span style="--c: var(--butter-deep)">Website 52%</span><span style="--c: var(--aftercare)">Instagram 31%</span><span style="--c: var(--mint)">Referral 17%</span></div>
          </div>
        </div>
      </article>

      <article class="tile tile--alert glass" data-light data-reveal data-inview style="--d: 80ms">
        <h3>Alert the team</h3>
        <p>Running late, or need a hand with a patient right now? One tap sends an urgent alert that pops up on your colleagues' screens, ready to acknowledge or answer.</p>
        <div class="alert" aria-hidden="true">
          <div class="alert__pop">
            <span class="alert__k"><i></i>Urgent · Dr Rahman</span>
            <b>Patient feeling faint after treatment. Can someone come through?</b>
            <div class="alert__btns"><span class="alert__ok">Acknowledge</span><span>Reply</span></div>
          </div>
          <span class="alert__done">✓ Sofia is on her way</span>
        </div>
      </article>

      <article class="tile tile--kpi glass" data-light data-reveal data-inview style="--d: 160ms">
        <h3>Practitioner KPIs</h3>
        <p>Revenue, treatments, attendance and retention for each practitioner, with commission worked out.</p>
        <div class="kpis" aria-hidden="true">
          <div class="kpis__row kpis__head"><span></span><span>Revenue</span><span>Attendance</span></div>
          {kpis.map((k, i) => (
            <div class="kpis__row" style={`--w:${k.v}%; --i:${i}`}><span>{k.who}</span><i></i><em>{k.a}</em></div>
          ))}
        </div>
      </article>

      <article class="tile tile--board glass" data-light data-reveal data-inview style="--d: 80ms">
        <h3>Every patient on a journey board</h3>
        <p>Patients on a plan, grouped by stage, with late steps flagged before anyone has to ask.</p>
        <div class="board" aria-hidden="true">
          {board.map((c, i) => (
            <div class="board__col" style={`--i:${i}`}>
              <span>{c.k} <b>{c.n}</b></span>
              <i></i>
              <i class={c.late ? "late" : ""}></i>
              {i < 3 && <i></i>}
            </div>
          ))}
        </div>
      </article>

      <article class="tile tile--access glass" data-light data-reveal data-inview style="--d: 160ms">
        <h3>Access you control</h3>
        <p>Choose exactly what managers, practitioners and front desk can see, down to a single tab of the patient record.</p>
        <div class="access" aria-hidden="true">
          <span></span><b>Manager</b><b>Practitioner</b><b>Front desk</b>
          {access.map((row, r) => (
            <Fragment>
              <span>{row}</span>
              {accessOn[r].map((on, c) => <i class={on ? "on" : ""} style={`--i:${r * 3 + c}`}></i>)}
            </Fragment>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .bento__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }
  .bento__pause {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid var(--edge-2);
    background: var(--glass-2);
    border-radius: 999px;
    padding: 0.45rem 0.95rem;
    cursor: pointer;
    font-size: 0.85rem;
    flex: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(15rem, auto);
    gap: 1.1rem;
  }
  .tile {
    padding: 1.5rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .tile h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.7rem;
    line-height: 1.05;
  }
  .tile p {
    margin: 0 0 0.8rem;
    color: var(--ink-2);
    font-size: 0.95rem;
    max-width: 28rem;
  }
  .tile--diary {
    grid-column: span 4;
    grid-row: span 2;
  }
  .tile--focus {
    grid-column: span 2;
    grid-row: span 2;
  }
  .tile--funnel,
  .tile--alert,
  .tile--kpi {
    grid-column: span 2;
  }
  .tile--board,
  .tile--access {
    grid-column: span 3;
  }

  /* Diary: live planner, then Needs action as a feature. */
  .mini-diary {
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .mini-diary__stage {
    position: relative;
    aspect-ratio: 1600 / 869;
    overflow: hidden;
    border-radius: 16px;
    background: #fbfbfc;
    box-shadow:
      inset 0 0 0 1px var(--edge-2),
      0 18px 40px -24px rgba(47, 63, 102, 0.35);
  }
  .mini-diary__stage::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    z-index: 10;
    height: 2.75rem;
    background: linear-gradient(to bottom, transparent, rgba(251, 251, 252, 0.95));
    pointer-events: none;
  }
  .mini-diary__canvas {
    position: absolute;
    inset: 0;
    transform-origin: 58% 42%;
    will-change: transform;
  }
  .mini-diary__shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .mini-diary__shot--on {
    clip-path: circle(0% at 72% 4%);
  }
  .mini-diary__shot--menu {
    opacity: 0;
  }
  /* Glow over the matched cards; radius tracks the card's own corners. */
  .mini-diary__ring {
    position: absolute;
    left: var(--l);
    top: var(--t);
    width: 29.5%;
    height: 13.16%;
    border-radius: 3.9% / 16%;
    box-shadow:
      0 0 0 2px rgba(163, 69, 110, 0.4),
      0 14px 34px -12px rgba(163, 69, 110, 0.55);
    opacity: 0;
    pointer-events: none;
  }
  .mini-diary__ripple {
    position: absolute;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(163, 69, 110, 0.28), rgba(163, 69, 110, 0) 70%);
    box-shadow: 0 0 0 1.5px rgba(163, 69, 110, 0.35);
    opacity: 0;
    pointer-events: none;
  }
  .mini-diary__cursor {
    position: absolute;
    left: 46%;
    top: 72%;
    z-index: 5;
    transform-origin: 4px 3px;
    fill: var(--ink);
    stroke: #fff;
    stroke-width: 1.5;
    stroke-linejoin: round;
    filter: drop-shadow(0 3px 6px rgba(47, 63, 102, 0.35));
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .mini-diary__shot--on {
      clip-path: none;
    }
    .mini-diary__ring {
      opacity: 1;
    }
  }

  /* Where to focus */
  .focus {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.3rem;
  }
  .focus__row {
    display: flex;
    gap: 0.65rem;
    padding: 0.65rem 0.75rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--edge);
    opacity: 0;
    transform: translateY(10px);
  }
  .focus__row i {
    flex: none;
    width: 9px;
    height: 9px;
    margin-top: 0.35rem;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 25%, transparent);
  }
  .focus__row b {
    display: block;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .focus__row small {
    font-size: 0.76rem;
    color: var(--ink-3);
  }
  .tile--focus.is-in .focus__row {
    opacity: 1;
    transform: none;
    transition: all 700ms var(--ease-dew) calc(300ms + var(--i) * 220ms);
  }
  .tile--focus.is-in .focus__row:first-child {
    animation: focus-glow 6s var(--ease-dew) 2s infinite;
  }
  @keyframes focus-glow {
    0%,
    100% {
      box-shadow: none;
    }
    20%,
    60% {
      box-shadow: 0 0 0 2px var(--butter), var(--shadow-lift);
    }
  }

  /* Insights */
  .sources {
    display: grid;
    gap: 0.45rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--edge-2);
  }
  .sources__bar {
    display: flex;
    gap: 3px;
    height: 0.55rem;
  }
  .sources__bar i {
    width: var(--w);
    border-radius: 4px;
    background: var(--c);
  }
  .sources__key {
    display: flex;
    justify-content: space-between;
    gap: 0.4rem;
  }
  .sources__key span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: var(--ink-2);
  }
  .sources__key span::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c);
  }

  /* Alert the team */
  .alert {
    position: relative;
    margin-top: auto;
    min-height: 8.6rem;
  }
  .alert__pop {
    display: grid;
    gap: 0.45rem;
    padding: 0.85rem 0.95rem;
    border-radius: 16px;
    background: #fff;
    border: 1px solid rgba(239, 155, 196, 0.6);
    box-shadow: 0 16px 34px -16px rgba(163, 69, 110, 0.45);
    font-size: 0.82rem;
    opacity: 0;
    transform: translateY(14px) scale(0.97);
  }
  .alert__k {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--aftercare-ink);
  }
  .alert__k i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e0548a;
  }
  .alert__pop b {
    font-weight: 600;
    line-height: 1.3;
  }
  .alert__btns {
    display: flex;
    gap: 0.4rem;
  }
  .alert__btns span {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(47, 63, 102, 0.12);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .alert__btns .alert__ok {
    background: var(--butter);
    border-color: transparent;
  }
  .alert__done {
    position: absolute;
    right: 0.4rem;
    bottom: -0.2rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(166, 220, 205, 0.6);
    color: var(--success-ink);
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0;
  }
  .tile--alert.is-in .alert__pop {
    animation: alert-in 7s var(--ease-dew) 0.4s infinite;
  }
  .tile--alert.is-in .alert__done {
    animation: alert-done 7s var(--ease-dew) 0.4s infinite;
  }
  @keyframes alert-in {
    0% {
      opacity: 0;
      transform: translateY(14px) scale(0.97);
    }
    8%,
    88% {
      opacity: 1;
      transform: none;
    }
    12%,
    20% {
      box-shadow: 0 0 0 4px rgba(239, 155, 196, 0.35), 0 16px 34px -16px rgba(163, 69, 110, 0.45);
    }
    100% {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @keyframes alert-done {
    0%,
    40% {
      opacity: 0;
      transform: translateY(6px);
    }
    48%,
    88% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  /* Insights funnel */
  .funnel {
    margin-top: 0.4rem;
    display: grid;
    gap: 0.6rem;
    padding: 0.9rem 1rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--edge);
  }
  .funnel__row {
    display: grid;
    grid-template-columns: 4.6rem 1fr 1.8rem;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    color: var(--ink-3);
  }
  .funnel__row em {
    font-style: normal;
    text-align: right;
    font-weight: 600;
    color: var(--ink);
  }
  .funnel__head {
    grid-template-columns: 1fr auto;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .funnel__head span:nth-child(2) {
    display: none;
  }
  .funnel__head em {
    font-weight: 400;
    color: var(--ink-3);
  }
  .funnel__row i {
    height: 0.6rem;
    width: 0;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--butter), var(--butter-deep));
  }
  .funnel__row:nth-last-child(2) i {
    background: linear-gradient(90deg, var(--mint), var(--success));
  }
  .tile--funnel.is-in .funnel__row i {
    width: var(--w);
    transition: width 1s var(--ease-dew) calc(200ms + var(--i) * 180ms);
  }

  /* Practitioner KPIs */
  .kpis {
    margin-top: 0.4rem;
    display: grid;
    gap: 0.7rem;
    padding: 0.9rem 1rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--edge);
  }
  .kpis__head {
    font-size: 0.68rem !important;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3) !important;
  }
  .kpis__head span:last-child {
    text-align: right;
  }
  .kpis__row {
    display: grid;
    grid-template-columns: 5.4rem 1fr auto;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    color: var(--ink-2);
  }
  .kpis__row i {
    height: 0.6rem;
    width: 0;
    border-radius: 6px;
    background: var(--arrived);
  }
  .kpis__row em {
    font-style: normal;
    font-weight: 600;
    color: var(--success-ink);
  }
  .tile--kpi.is-in .kpis__row i {
    width: var(--w);
    transition: width 1s var(--ease-dew) calc(200ms + var(--i) * 160ms);
  }

  /* Journey board */
  .board {
    margin-top: auto;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .board__col {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 0.55rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--edge);
    min-height: 7.5rem;
  }
  .board__col span {
    font-size: 0.72rem;
    color: var(--ink-3);
    font-weight: 600;
  }
  .board__col span b {
    color: var(--ink);
  }
  .board__col i {
    height: 1.4rem;
    border-radius: 8px;
    background: linear-gradient(90deg, var(--butter-deep) 0 3px, rgba(255, 255, 255, 0.95) 3px);
    box-shadow: 0 1px 2px rgba(47, 63, 102, 0.08);
    opacity: 0;
    transform: translateY(6px);
  }
  .board__col i.late {
    background: linear-gradient(90deg, var(--aftercare) 0 3px, rgba(255, 238, 246, 0.95) 3px);
  }
  .tile--board.is-in .board__col i {
    opacity: 1;
    transform: none;
    transition: all 600ms var(--ease-dew) calc(250ms + var(--i) * 150ms);
  }
  .tile--board.is-in .board__col i.late {
    animation: late 3s ease-in-out 1.5s infinite;
  }
  @keyframes late {
    50% {
      box-shadow: 0 0 0 3px rgba(239, 155, 196, 0.45);
    }
  }

  /* Access grid */
  .access {
    margin-top: auto;
    display: grid;
    grid-template-columns: 1fr repeat(3, 4.6rem);
    align-items: center;
    row-gap: 0.45rem;
    font-size: 0.76rem;
    color: var(--ink-2);
  }
  .access b {
    font-weight: 600;
    font-size: 0.68rem;
    color: var(--ink-3);
    text-align: center;
  }
  .access i {
    justify-self: center;
    position: relative;
    width: 1.9rem;
    height: 1.05rem;
    border-radius: 999px;
    background: rgba(47, 63, 102, 0.12);
    transition: background 400ms var(--ease-dew) calc(300ms + var(--i) * 70ms);
  }
  .access i::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: calc(1.05rem - 4px);
    height: calc(1.05rem - 4px);
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgba(47, 63, 102, 0.25);
    transition: transform 400ms var(--ease-dew) calc(300ms + var(--i) * 70ms);
  }
  .tile--access.is-in .access i.on {
    background: var(--butter-deep);
  }
  .tile--access.is-in .access i.on::after {
    transform: translateX(0.85rem);
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tile--diary {
      grid-column: span 2;
      grid-row: auto;
    }
    .tile--focus,
    .tile--funnel,
    .tile--alert,
    .tile--kpi,
    .tile--board,
    .tile--access {
      grid-column: span 1;
      grid-row: auto;
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .tile--diary,
    .tile--focus,
    .tile--funnel,
    .tile--alert,
    .tile--kpi,
    .tile--board,
    .tile--access {
      grid-column: auto;
    }
    .bento__head {
      display: block;
    }
    .bento__pause {
      margin: -1.5rem 0 1.5rem;
    }
    /* Keep the planner legible on a phone: show its right-hand side larger. */
    .mini-diary__stage {
      aspect-ratio: 941 / 869;
    }
    .mini-diary__canvas {
      inset: 0 0 auto auto;
      width: 170%;
      aspect-ratio: 1600 / 869;
    }
  }
</style>

<script>
  import { gsap, reducedMotion, motionPaused } from "../scripts/motion";

  const tile = document.querySelector<HTMLElement>("[data-diary]");
  if (tile) {
    const pick = (s: string) => tile.querySelector<HTMLElement>(s)!;
    const canvas = pick("[data-diary-canvas]");
    const on = pick('[data-diary-shot="on"]');
    const menu = pick('[data-diary-shot="menu"]');
    const cursor = pick("[data-diary-cursor]");
    const ripple = pick("[data-diary-ripple]");
    const rings = tile.querySelectorAll<HTMLElement>("[data-diary-ring]");

    // Points measured on the live planner capture, as % of its width and height.
    const at = (x: number, y: number) => ({ left: `${x}%`, top: `${y}%` });
    const START = at(46, 72);
    const CARET = at(78.05, 4.1);
    const ANY = at(70.2, 10.6);
    const REST = at(88, 36);
    const CLEAR = at(77.7, 4.1);
    const MENU_SHUT = "inset(6.6% 20.2% 92% 60.6% round 14px)";
    const MENU_OPEN = "inset(6.6% 20.2% 53.8% 60.6% round 14px)";

    gsap.set(ripple, { xPercent: -50, yPercent: -50 });

    const tl = gsap.timeline({ repeat: -1, paused: true, defaults: { ease: "power3.inOut" } });
    const click = (time: number, point: { left: string; top: string }) => {
      tl.to(cursor, { scale: 0.8, duration: 0.08, ease: "power2.in" }, time)
        .to(cursor, { scale: 1, duration: 0.3, ease: "back.out(3)" }, time + 0.08)
        .fromTo(
          ripple,
          { ...point, scale: 0.25, autoAlpha: 1 },
          { scale: 1.4, autoAlpha: 0, duration: 0.55, ease: "power2.out", immediateRender: false },
          time + 0.04,
        );
    };

    tl.set(on, { clipPath: "circle(0% at 72% 4%)" }, 0)
      .set(menu, { clipPath: MENU_SHUT, autoAlpha: 0 }, 0)
      .set(rings, { autoAlpha: 0, scale: 1.06 }, 0)
      .set(canvas, { scale: 1 }, 0)
      .fromTo(cursor, { ...START, autoAlpha: 0 }, { autoAlpha: 1, duration: 0.25, ease: "power1.out" }, 0.1)
      .to(cursor, { ...CARET, duration: 0.75 }, 0.2);
    click(0.95, CARET);
    tl.to(menu, { clipPath: MENU_OPEN, autoAlpha: 1, duration: 0.32, ease: "power3.out" }, 1.02)
      .to(cursor, { ...ANY, duration: 0.45 }, 1.35);
    click(1.85, ANY);
    tl.to(menu, { autoAlpha: 0, duration: 0.16, ease: "power1.out" }, 1.95)
      .to(on, { clipPath: "circle(150% at 72% 4%)", duration: 0.7, ease: "power2.inOut" }, 1.95)
      .to(cursor, { ...REST, duration: 0.7 }, 2.15)
      .to(canvas, { scale: 1.045, duration: 1.8, ease: "power1.inOut" }, 2.1)
      .to(rings, { autoAlpha: 1, scale: 1, duration: 0.45, stagger: 0.12, ease: "back.out(2)" }, 2.45)
      .to(cursor, { ...CLEAR, duration: 0.55 }, 4.55);
    click(5.15, CLEAR);
    tl.to(rings, { autoAlpha: 0, duration: 0.2, ease: "power1.out" }, 5.2)
      .to(on, { clipPath: "circle(0% at 77.7% 4.1%)", duration: 0.55, ease: "power2.in" }, 5.22)
      .to(canvas, { scale: 1, duration: 0.8 }, 5.22)
      .to(cursor, { autoAlpha: 0, duration: 0.3, ease: "power1.out" }, 5.7)
      .to({}, { duration: 0.5 }, 6.0);

    // Still frame: the filter applied, no cursor.
    let frozen = false;
    const still = () => {
      frozen = true;
      tl.pause(3.4);
      gsap.set(cursor, { autoAlpha: 0 });
    };

    if (reducedMotion()) {
      still();
    } else {
      let visible = false;
      const sync = () => {
        if (motionPaused()) return still();
        if (!visible) return tl.pause();
        if (frozen) {
          frozen = false;
          tl.restart();
        } else tl.play();
      };
      new IntersectionObserver(
        ([e]) => {
          visible = e.isIntersecting;
          sync();
        },
        { threshold: 0.3 },
      ).observe(tile);
      addEventListener("aetheria:motion", sync);
    }
  }
</script>
