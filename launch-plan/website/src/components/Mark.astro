---
// The Aetheria mark: an Æ inside a butter droplet.
interface Props { size?: number; class?: string }
const { size = 32, class: cls = "" } = Astro.props;
const id = `m${Math.random().toString(36).slice(2, 8)}`;
---
<svg class={`mark ${cls}`} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <radialGradient id={`${id}g`} cx="36%" cy="30%" r="75%">
      <stop offset="0" stop-color="#fffaf0" />
      <stop offset=".5" stop-color="#eed488" />
      <stop offset="1" stop-color="#c9a64a" />
    </radialGradient>
  </defs>
  <path d="M32 4C32 4 12 28 12 40a20 20 0 0 0 40 0C52 28 32 4 32 4Z" fill={`url(#${id}g)`} />
  <ellipse cx="25" cy="33" rx="4" ry="6" fill="#fff" opacity=".55" transform="rotate(20 25 33)" />
  <text x="32" y="48" text-anchor="middle" font-family="Instrument Serif, Georgia, serif" font-size="24" fill="#2f3f66">Æ</text>
</svg>
