---
// The patient journal: a short looping story of one entry being written
// (note, photo, voice note), saved to the timeline, then shared by link with
// the clinic or kept as a personal copy. Built in code, pausable, and shown
// as a still frame under reduced motion.
const earlier = [
  { d: "Day 9", t: "Tried the barrier cream. Less tight in the morning.", tag: "Skincare" },
  { d: "Day 5", t: "Some flaking on the cheeks, settling.", tag: "Skin change" },
];
---

<section class="jr section" id="patients-journal" aria-labelledby="jr-title">
  <div class="wrap jr__grid">
    <div class="jr__copy">
      <p class="eyebrow">The patient journal</p>
      <h2 id="jr-title" class="display" data-lines>
        <span class="line-mask"><span>Results that are</span></span>
        <span class="line-mask"><span><em>theirs</em> to share.</span></span>
      </h2>
      <p class="lede">
        Patients see their own before and after on their plan. Between visits, they keep a journal of how their skin is
        really doing: a quick note, a thought, a photo in the same light, or a voice note when typing is too much.
      </p>
      <ul class="jr__facts">
        <li><b>Notes, photos and voice notes</b> in one timeline, tagged by skincare, skin changes or vitamins</li>
        <li><b>Shared on their terms</b>, with their clinic, as a personal link, or not at all</li>
        <li><b>Nothing lost between visits.</b> Their practitioner sees what changed before they walk in</li>
      </ul>
    </div>

    <figure class="jr__figure" data-journal aria-label="Illustration: a patient writes a journal entry and shares it with their clinic">
      <div class="phone glass" aria-hidden="true">
        <header class="phone__head">
          <b>Your Journal</b>
          <small>Microneedling course · week 2</small>
        </header>

        <div class="entry">
          <p class="entry__day">Day 12 · Tue 14 Oct</p>
          <p class="entry__text"><span>Skin feels calmer today, redness almost gone.</span></p>
          <div class="entry__att">
            <span class="att att--photo"><i></i>Photo</span>
            <span class="att att--voice">
              <b>▶</b>
              {Array.from({ length: 14 }).map((_, i) => <i style={`--i:${i}`}></i>)}
              <em>0:18</em>
            </span>
          </div>
          <div class="entry__foot">
            <span class="tag">Skin change</span>
            <span class="save">Save entry</span>
          </div>
        </div>

        <ol class="timeline">
          <li class="timeline__new">
            <span class="timeline__d">Day 12</span>
            <span class="timeline__t">Skin feels calmer today, redness almost gone.</span>
            <span class="timeline__icons">Photo · Voice 0:18</span>
          </li>
          {earlier.map((e) => (
            <li>
              <span class="timeline__d">{e.d}</span>
              <span class="timeline__t">{e.t}</span>
              <span class="timeline__icons">{e.tag}</span>
            </li>
          ))}
        </ol>

        <div class="share">
          <b>Share your journal</b>
          <div class="share__opts">
            <span class="opt opt--clinic"><i></i>With my clinic</span>
            <span class="opt"><i></i>Personal link</span>
          </div>
          <span class="share__link"><span>sqinos.link/j/olivia-wk2</span><em>Copied</em></span>
        </div>

        <div class="toast"><i></i>Dr Nadia Rahman can now see your journal</div>
      </div>

      <ol class="jr__steps" aria-hidden="true">
        <li>Write</li>
        <li>Add a photo</li>
        <li>Voice note</li>
        <li>Save</li>
        <li>Share</li>
      </ol>
      <figcaption>Illustration of the patient portal journal. Demo content, not a real patient.</figcaption>
    </figure>
  </div>
</section>

<style>
  .jr__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .jr__copy {
    display: grid;
    gap: 1.2rem;
  }
  .jr__facts {
    list-style: none;
    padding: 0;
    margin: 0.4rem 0 0;
    display: grid;
    gap: 0.6rem;
    color: var(--ink-2);
  }
  .jr__facts li {
    padding-left: 1.4rem;
    position: relative;
  }
  .jr__facts li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--butter);
    box-shadow: 0 0 0 4px var(--butter-soft);
  }
  .jr__facts b {
    color: var(--ink);
    font-weight: 600;
  }

  .jr__figure {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 1rem;
    position: relative;
  }
  .jr__figure::before {
    content: "";
    position: absolute;
    inset: 8% 6% 14%;
    border-radius: 40px;
    background:
      radial-gradient(60% 60% at 30% 30%, rgba(239, 155, 196, 0.28), transparent 70%),
      radial-gradient(60% 60% at 75% 70%, rgba(238, 212, 136, 0.35), transparent 70%);
    filter: blur(20px);
    z-index: -1;
  }
  .jr__figure figcaption {
    font-size: 0.8rem;
    color: var(--ink-3);
    text-align: center;
  }

  .phone {
    position: relative;
    width: min(100%, 24rem);
    height: 34rem;
    padding: 1.2rem;
    border-radius: 28px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    box-shadow: var(--shadow-deep);
    font-size: 0.9rem;
  }
  .phone__head b {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.1;
  }
  .phone__head small {
    color: var(--ink-3);
  }

  /* The entry being written */
  .entry {
    padding: 0.9rem;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--edge);
    box-shadow: 0 1px 2px rgba(47, 63, 102, 0.06);
    display: grid;
    gap: 0.55rem;
    transition:
      transform 700ms var(--ease-dew),
      opacity 500ms ease;
  }
  .entry__day {
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-3);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .entry__text {
    margin: 0;
    min-height: 2.6em;
    line-height: 1.3;
  }
  .entry__text span {
    background: linear-gradient(90deg, var(--ink), var(--ink)) no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    background-size: 0% 100%;
    transition: background-size 1.4s steps(44, end);
  }
  .entry__text::after {
    content: "";
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--butter-deep);
    animation: caret 1s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  .entry__att {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 2.2rem;
  }
  .att {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem 0.3rem 0.3rem;
    border-radius: 12px;
    background: rgba(47, 63, 102, 0.05);
    font-size: 0.78rem;
    color: var(--ink-2);
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity 400ms ease,
      transform 600ms var(--ease-dew);
  }
  .att--photo i {
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 8px;
    background: radial-gradient(circle at 35% 35%, #e6bfa3, #c08a67 70%, #9a6445);
  }
  .att--voice {
    gap: 2px;
    padding-left: 0.5rem;
  }
  .att--voice b {
    font-size: 0.6rem;
    margin-right: 0.3rem;
    color: var(--butter-ink);
  }
  .att--voice i {
    width: 3px;
    height: 0.9rem;
    border-radius: 2px;
    background: var(--butter-deep);
    transform: scaleY(0.35);
  }
  .att--voice em {
    font-style: normal;
    margin-left: 0.4rem;
    font-size: 0.72rem;
    color: var(--ink-3);
  }
  .entry__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .tag {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--butter-soft);
    color: var(--butter-ink);
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .save {
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--butter);
    font-size: 0.76rem;
    font-weight: 600;
    transition: transform 200ms ease;
  }

  /* Timeline under the entry */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.9rem;
    display: grid;
    gap: 0.55rem;
    border-left: 2px solid var(--butter-line);
  }
  .timeline li {
    position: relative;
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.75rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--edge);
    font-size: 0.8rem;
  }
  .timeline li::before {
    content: "";
    position: absolute;
    left: calc(-0.9rem - 6px);
    top: 0.9rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--butter);
    border: 2px solid #fff;
  }
  .timeline__d {
    font-weight: 600;
    font-size: 0.72rem;
    color: var(--ink-3);
  }
  .timeline__icons {
    font-size: 0.7rem;
    color: var(--ink-3);
  }
  .timeline__new {
    max-height: 0;
    padding-block: 0 !important;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 700ms var(--ease-dew),
      padding 700ms var(--ease-dew),
      opacity 500ms ease;
  }

  /* Share sheet */
  .share {
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.8rem;
    padding: 1rem;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 -10px 40px -12px rgba(47, 63, 102, 0.35);
    display: grid;
    gap: 0.6rem;
    transform: translateY(115%);
    transition: transform 800ms var(--ease-dew);
  }
  .share b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.3rem;
  }
  .share__opts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .opt {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.65rem;
    border-radius: 12px;
    border: 1px solid rgba(47, 63, 102, 0.12);
    font-size: 0.8rem;
    transition: all 400ms var(--ease-dew);
  }
  .opt i {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    border: 1.5px solid rgba(47, 63, 102, 0.3);
    transition: all 400ms var(--ease-dew);
  }
  .share__link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.55rem 0.75rem;
    border-radius: 12px;
    background: rgba(47, 63, 102, 0.05);
    font-size: 0.8rem;
    color: var(--ink-2);
    opacity: 0;
    transition: opacity 500ms ease;
  }
  .share__link em {
    font-style: normal;
    font-weight: 600;
    font-size: 0.72rem;
    color: var(--success-ink);
    opacity: 0;
    transition: opacity 400ms ease 500ms;
  }
  .toast {
    position: absolute;
    top: 1rem;
    left: 50%;
    transform: translate(-50%, -160%);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: max-content;
    max-width: 90%;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 0.78rem;
    box-shadow: var(--shadow-lift);
    transition: transform 700ms var(--ease-dew);
  }
  .toast i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--mint);
  }

  .jr-reset *,
  .jr-reset *::before {
    transition: none !important;
  }

  /* Step captions */
  .jr__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }
  .jr__steps li {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--ink-3);
    border: 1px solid var(--edge-2);
    background: var(--glass-2);
    transition: all 400ms var(--ease-dew);
  }

  /* ---------- The storyline, one class per beat ---------- */
  .s1 .entry__text span {
    background-size: 100% 100%;
  }
  .s2 .att--photo,
  .s3 .att--voice {
    opacity: 1;
    transform: none;
  }
  .s3:not(.s4) .att--voice i {
    animation: wave 900ms ease-in-out infinite;
    animation-delay: calc(var(--i) * -70ms);
  }
  @keyframes wave {
    0%,
    100% {
      transform: scaleY(0.3);
    }
    50% {
      transform: scaleY(1);
    }
  }
  .s4 .att--voice i {
    transform: scaleY(0.6);
  }
  .s4 .tag {
    opacity: 1;
  }
  .s4 .save {
    transform: scale(0.94);
  }
  .s5 .entry {
    opacity: 0;
    transform: translateY(40%) scale(0.96);
    position: absolute;
    left: 1.2rem;
    right: 1.2rem;
    top: 4.6rem;
    pointer-events: none;
  }
  .s5 .timeline__new {
    max-height: 5rem;
    padding-block: 0.55rem !important;
    opacity: 1;
  }
  .s5 .timeline__new::before {
    animation: pop 700ms var(--ease-dew);
  }
  @keyframes pop {
    0% {
      transform: scale(0);
    }
    70% {
      transform: scale(1.5);
    }
  }
  .s6 .share {
    transform: none;
  }
  .s7 .opt--clinic {
    border-color: var(--butter-deep);
    background: var(--butter-wash);
  }
  .s7 .opt--clinic i {
    border: 4px solid var(--butter-deep);
  }
  .s7 .share__link,
  .s7 .share__link em {
    opacity: 1;
  }
  .s8 .toast {
    transform: translate(-50%, 0);
  }
  .s8 .entry__text::after,
  .s5 .entry__text::after {
    display: none;
  }
  /* captions follow the beats */
  .s1 .jr__steps li:nth-child(1),
  .s2 .jr__steps li:nth-child(2),
  .s3 .jr__steps li:nth-child(3),
  .s5 .jr__steps li:nth-child(4),
  .s6 .jr__steps li:nth-child(5) {
    color: var(--ink);
    border-color: var(--butter-line);
    background: var(--butter-wash);
  }

  @media (max-width: 900px) {
    .jr__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { reducedMotion, motionPaused } from "../scripts/motion";

  const fig = document.querySelector<HTMLElement>("[data-journal]");
  if (fig) {
    // Beats: 1 type · 2 photo · 3 voice · 4 tag + save · 5 into the timeline
    // · 6 share sheet · 7 clinic chosen, link made · 8 confirmation. Then reset.
    const beats = [0, 1, 2, 3, 4, 5, 6, 7, 8];
    const hold = [700, 1900, 1400, 2200, 1300, 1700, 1500, 1800, 3200];
    const last = beats[beats.length - 1];
    let step = 0;
    let timer = 0;
    let visible = false;

    const paint = (s: number) => {
      for (let k = 1; k <= last; k++) fig.classList.toggle(`s${k}`, k <= s);
    };
    const tick = () => {
      clearTimeout(timer);
      if (motionPaused()) return paint(last);
      if (!visible) return;
      if (step === 0) {
        // Start the story again without playing it backwards.
        fig.classList.add("jr-reset");
        paint(0);
        void fig.offsetWidth;
        fig.classList.remove("jr-reset");
      } else paint(step);
      const wait = hold[step];
      step = step >= last ? 0 : step + 1;
      timer = window.setTimeout(tick, wait);
    };

    if (reducedMotion()) {
      paint(last);
    } else {
      new IntersectionObserver(
        ([e]) => {
          visible = e.isIntersecting;
          if (visible) tick();
          else clearTimeout(timer);
        },
        { threshold: 0.35 },
      ).observe(fig);
      addEventListener("aetheria:motion", (e) => {
        const paused = (e as CustomEvent).detail.paused;
        if (paused) {
          clearTimeout(timer);
          paint(last);
        } else tick();
      });
    }
  }
</script>
