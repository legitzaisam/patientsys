# Website build settings (all optional). Copy to website/.env.local.
# Where the sign-in buttons go. Defaults use the gateway's demo entry points.
PUBLIC_CLINIC_SIGNIN_URL=/demo/enter?role=owner
PUBLIC_PATIENT_SIGNIN_URL=/demo/enter?role=patient
# Show the persona picker (owner / practitioner / front desk) on /login.
PUBLIC_DEMO_PERSONAS=true
# Shown on /contact as the direct address, and used by the form when no form
# service key is set (the form then opens a prefilled email).
PUBLIC_CONTACT_EMAIL=
# /contact form delivery. Access key from https://web3forms.com (free; the key
# is emailed to the address that will receive messages). Leave empty to use
# the mailto fallback. The endpoint only changes if you swap the form service.
PUBLIC_CONTACT_FORM_KEY=
PUBLIC_CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit
# Canonical site URL once a domain exists, e.g. https://www.example.com
SITE_URL=
